 "unclear": [
  {
   "id": "U1",
   "text": "Whether time logged in and waiting for a request is time during which the worker is required by the network company to remain available (engaged time under §5(2)).",
   "readings": [
    "U1-a: no; a worker may log off at will, so only time on a trip and any scheduled shift is engaged time",
    "U1-b: yes; the apps reduce the priority of workers who decline requests, so all logged-in time is engaged time"
   ],
