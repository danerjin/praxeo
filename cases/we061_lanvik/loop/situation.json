 "assumptions": {
  "a1": {
   "text": "The Act is enforced: audits and private suits with double damages make treating workers as contractors without a valid agreement costly.",
   "class": "enforcement",
   "p": 0.8
  },
  "a2": {
   "text": "Each company elects to offer contractor agreements.",
   "class": "other",
   "p": 0.75
  },
  "a3": {
   "text": "Some hours on a trip pay below 16 per hour on a trip (about a fifth).",
   "class": "binding",
   "p": 0.9
  },
  "a4": {
   "text": "Platforms pass part of their added cost per trip into fares and fees, and some riders and diners take fewer trips at the higher price (taxis, transit and home cooking are partial substitutes).",
   "class": "substitutability",
   "p": 0.8
  },
  "a11": {
   "text": "Buyers of shares and medallions expect the Act to survive the court challenge and repeal campaign.",
   "class": "expectations",
   "p": 0.7
  },
  "a15": {
   "text": "Some delivery services can operate with fewer than 100 Lanvik workers.",
   "class": "other",
   "p": 0.5
  },
  "a17": {
   "text": "Some workers exceed 40 hours a week with one company (about 600 on trips; about 5,000 logged in), and companies can cap them.",
   "class": "other",
   "p": 0.85
  },
  "a18": {
   "text": "Companies control dispatch enough to keep part-time employees' weekly wages at or under 150.",
   "class": "other",
   "p": 0.7
  },
  "a26": {
   "text": "The Department's 4 million is new money from the general fund.",
   "class": "revenue_use",
   "p": 0.9
  },
  "a28": {
   "text": "§9 does not fix the fare share, and companies can cut fare shares and bonuses after launch.",
   "class": "other",
   "p": 0.75
  },
  "a29": {
   "text": "Fare shares are not cut in the first months (30 days' notice; scrutiny at launch).",
   "class": "other",
   "p": 0.6
  },
  "a31": {
   "text": "The floor's surplus of employee hours is rationed by stricter criteria than the counterfactual's dispatch ranking (shift allocation, acceptance thresholds).",
   "class": "other",
   "p": 0.7
  },
  "j1": {
   "text": "Some hours logged in pay below 16 per hour logged in (about three quarters).",
   "class": "binding",
   "p": 0.95
  },
  "q14_some_workers_prefer_the_contractor_agree": {
   "text": "Some workers prefer the contractor agreement with the premium to employee status.",
   "p": 0.85,
   "class": "other"
  },
  "q15_platforms_control_how_many_hours_of_work": {
   "text": "Platforms control how many hours of work each worker gets through dispatch.",
   "p": 0.9,
   "class": "other"
  },
  "q16_the_premium_dominates_the_effects_of_ent": {
   "text": "The premium dominates the effects of entry and fewer trips on contractors' hourly earnings.",
   "p": 0.35,
   "class": "other"
  },
  "q17_workers_paid_below_16_per_hour_on_a_trip": {
   "text": "Workers paid below 16 per hour on a trip mostly choose employee status (the top-up exceeds the premium and the flexibility they give up).",
   "p": 0.65,
   "class": "other"
  },
  "q18_some_workers_can_work_through_one_person": {
   "text": "Some workers can work through one-person companies, which §3 does not cover.",
   "p": 0.55,
   "class": "other"
  },
  "q19_the_contributions_are_paid_into_the_unem": {
   "text": "The contributions are paid into the unemployment and social insurance funds.",
   "p": 0.95,
   "class": "revenue_use"
  },
  "q20_some_services_can_be_reshaped_to_meet_th": {
   "text": "Some services can be reshaped to meet the three conditions at a cost below the Act's burden.",
   "p": 0.5,
   "class": "other"
  },
  "q21_companies_can_steer_requests_between_emp": {
   "text": "Companies can steer requests between employees and contractors through dispatch.",
   "p": 0.6,
   "class": "other"
  },
  "q22_under_u1_b_companies_schedule_employees_": {
   "text": "Under U1-b, companies schedule employees' logged-in time to cut paid waiting.",
   "p": 0.85,
   "class": "other"
  },
  "q23_enforcement_is_imperfect_some_misclassif": {
   "text": "Enforcement is imperfect: some misclassification and some pressure to sign occur.",
   "p": 0.65,
   "class": "enforcement"
  },
  "q24_companies_drivers_groups_and_unions_can_": {
   "text": "Companies, drivers' groups and unions can organize at a cost below their stakes.",
   "p": 0.9,
   "class": "other"
  },
  "q25_platforms_do_not_recover_all_of_their_ad": {
   "text": "Platforms do not recover all of their added cost through fares and fare shares.",
   "p": 0.85,
   "class": "other"
  },
  "q26_some_workers_can_move_hours_between_trip": {
   "text": "Some workers can move hours between trips starting in Selvane and in Lanvik.",
   "p": 0.65,
   "class": "mobility"
  },
  "q27_some_employees_whose_hours_are_cut_quali": {
   "text": "Some employees whose hours are cut qualify for and claim benefits.",
   "p": 0.6,
   "class": "other"
  },
  "q28_workers_whose_hours_with_one_company_are": {
   "text": "Workers whose hours with one company are capped take the hours from another company.",
   "p": 0.7,
   "class": "other"
  },
  "q29_under_u1_b_workers_who_wait_much_of_thei": {
   "text": "Under U1-b, workers who wait much of their logged-in time choose employee status.",
   "p": 0.7,
   "class": "other"
  },
  "q30_workers_split_their_hours_among_companie": {
   "text": "Workers split their hours among companies to keep weekly wages from each company at or under 150.",
   "p": 0.65,
   "class": "other"
  },
  "q31_onboarding_of_new_contractors_takes_four": {
   "text": "Onboarding of new contractors takes four to six weeks, so entry is partial in the first months.",
   "p": 0.6,
   "class": "durability"
  },
  "q32_new_contractors_share_the_same_requests_": {
   "text": "New contractors share the same requests with the contractors already signed.",
   "p": 0.8,
   "class": "other"
  },
  "q33_taxis_are_a_substitute_for_some_app_ride": {
   "text": "Taxis are a substitute for some app rides, at fares fixed by the city, with the medallion cap binding; taxis have idle capacity at the fixed fare, so more riders mean more trips per medallion.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q34_some_riders_do_not_cut_their_trips_at_th": {
   "text": "Some riders do not cut their trips at the higher fares (airport, late-night and mobility-limited riders with no close substitute).",
   "p": 0.75,
   "class": "substitutability"
  },
  "q35_restaurants_delivery_orders_fall_as_deli": {
   "text": "Restaurants' delivery orders fall as delivery fees rise.",
   "p": 0.8,
   "class": "other"
  },
  "q36_some_restaurants_hire_their_own_couriers": {
   "text": "Some restaurants hire their own couriers rather than pay the higher fees.",
   "p": 0.55,
   "class": "substitutability"
  }
 }
