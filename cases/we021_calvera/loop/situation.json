 "assumptions": {
  "a1": {
   "text": "Installers do not capture the whole subsidy.",
   "class": "other",
   "p": 0.85
  },
  "a3": {
   "text": "The surcharge is passed through to customers in full, and their demand changes little.",
   "class": "other",
   "p": 0.95
  },
  "a4": {
   "text": "Installation labor cannot grow much within the first year.",
   "class": "other",
   "p": 0.7
  },
  "a8": {
   "text": "Households knew of the subsidy from September and could wait.",
   "class": "expectations",
   "p": 0.8
  },
  "q5_certification_is_easy_enough_that_new_in": {
   "text": "Certification is easy enough that new installers enter.",
   "p": 0.8,
   "class": "other"
  },
  "q6_fraudulent_claims_are_made_on_a_meaningf": {
   "text": "Fraudulent claims are made on a meaningful scale.",
   "p": 0.2,
   "class": "enforcement"
  },
  "q7_entrants_make_investments_specific_to_so": {
   "text": "Entrants make investments specific to solar installation that lose value when the program ends.",
   "p": 0.7,
   "class": "durability"
  },
  "q8_in_the_first_year_installers_have_clearl": {
   "text": "In the first year, installers have clearly fewer alternatives than households: their capacity is fixed by the number of licensed electricians (A-4), while households can wait or keep buying grid power.",
   "p": 0.65,
   "class": "substitutability"
  },
  "q9_installers_suppliers_and_large_users_can": {
   "text": "Installers, suppliers and large users can organize to lobby at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q10_the_part_of_the_subsidy_that_installers_": {
   "text": "The part of the subsidy that installers keep exceeds what certification costs them.",
   "p": 0.8,
   "class": "other"
  },
  "q11_some_households_at_the_margin_install_be": {
   "text": "Some households at the margin install because of the subsidy.",
   "p": 0.9,
   "class": "substitutability"
  },
  "q12_adopters_buy_less_grid_power_after_insta": {
   "text": "Adopters buy less grid power after installing.",
   "p": 0.95,
   "class": "substitutability"
  },
  "q13_oversizing_toward_the_10_kw_limit_is_fea": {
   "text": "Oversizing toward the 10 kW limit is feasible and pays under net metering.",
   "p": 0.65,
   "class": "other"
  },
  "q14_some_adopters_would_have_installed_later": {
   "text": "Some adopters would have installed later without the subsidy.",
   "p": 0.8,
   "class": "expectations"
  },
  "q15_installer_capacity_is_limited_near_step_": {
   "text": "Installer capacity is limited near step-downs, so backlogs form.",
   "p": 0.75,
   "class": "other"
  },
  "q16_rooftop_output_is_large_enough_to_lower_": {
   "text": "Rooftop output is large enough to lower midday wholesale prices (it is not offset by withdrawal of other supply), and the reduction reaches retail rates.",
   "p": 0.55,
   "class": "substitutability"
  },
  "q17_the_commission_recovers_fixed_grid_costs": {
   "text": "The Commission recovers fixed grid costs mainly per kWh, those costs do not fall with sales, and net metering credits exports at the full retail rate.",
   "p": 0.8,
   "class": "other"
  },
  "q18_electricians_and_roofers_are_scarce_and_": {
   "text": "Electricians and roofers are scarce and fully used elsewhere.",
   "p": 0.8,
   "class": "other"
  },
  "q19_calvera_s_purchases_are_large_enough_to_": {
   "text": "Calvera's purchases are large enough to raise world panel prices.",
   "p": 0.05,
   "class": "other"
  }
 }
