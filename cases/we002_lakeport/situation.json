 "assumptions": {
  "a1": {
   "text": "Lakeport retailers pass at least part of the tax on in shelf prices.",
   "class": "other",
   "p": 0.9
  },
  "a2": {
   "text": "Buyers have untaxed substitutes they consider acceptable (water, diet drinks, juice).",
   "class": "substitutability",
   "p": 0.9
  },
  "a3": {
   "text": "Enough Lakeport residents can easily shop in the neighboring towns.",
   "class": "mobility",
   "p": 0.8
  },
  "a4": {
   "text": "Reformulation or relabeling to an exempt category is feasible for some products.",
   "class": "other",
   "p": 0.7
  },
  "a5": {
   "text": "Distributors evade the tax on a meaningful scale.",
   "class": "enforcement",
   "p": 0.3
  },
  "a6": {
   "text": "Free places draw some families who would otherwise have paid for private places.",
   "class": "substitutability",
   "p": 0.85
  },
  "a7": {
   "text": "Shoppers bundle drink purchases with other groceries on the same trip.",
   "class": "other",
   "p": 0.7
  },
  "a8": {
   "text": "Lakeport would otherwise have funded some pre-school places from general revenue, and the law does not fix that funding level.",
   "class": "revenue_use",
   "p": 0.65
  },
  "a9": {
   "text": "Sellers adjust their staffing or hours to their sales.",
   "class": "alternative_uses",
   "p": 0.75
  },
  "a10": {
   "text": "Earmarked spending on free places exceeds what the town would otherwise have spent on pre-school places from general revenue.",
   "class": "revenue_use",
   "p": 0.7
  },
  "a11": {
   "text": "Some families who would have kept their 3- and 4-year-olds at home or in informal care take a free place.",
   "class": "substitutability",
   "p": 0.8
  },
  "a12": {
   "text": "Lakeport retailers, the few registered distributors and approved pre-school providers can organize and spend to change or defend the tax at a cost below their stakes.",
   "class": "other",
   "p": 0.75
  }
 }
