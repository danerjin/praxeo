 "assumptions": {
  "a1": {
   "text": "Bound pharmacies comply with the $35 cap for most fills, and the payments they receive (contract rate, or the Fund's payment) exceed their acquisition cost, so they keep dispensing.",
   "p": 0.9,
   "class": "enforcement"
  },
  "a2": {
   "text": "2028 PBM contracts with pharmacies are not reopened during the year.",
   "p": 0.75,
   "class": "other"
  },
  "a4": {
   "text": "Most pharmacies have few cash insulin customers outside the Act, so they set their usual price at or near the Fund's limit.",
   "p": 0.75,
   "class": "other"
  },
  "a5": {
   "text": "The Board of Pharmacy does some enforcement work under the Act (complaints, audits of balance billing) from its existing fee-funded budget, which the Act does not raise.",
   "p": 0.8,
   "class": "revenue_use"
  },
  "a23": {
   "text": "The Act was not expected before its introduction in January 2027.",
   "p": 0.7,
   "class": "expectations"
  },
  "q6_some_covered_residents_used_less_insulin": {
   "text": "Some covered residents used less insulin than prescribed at the old price.",
   "p": 0.85,
   "class": "other"
  },
  "q7_when_the_patient_s_payment_is_the_same_f": {
   "text": "When the patient's payment is the same for every product, some patients and prescribers choose pens or newer analogs over vials and older products.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q8_some_residents_near_the_lisvane_line_fil": {
   "text": "Some residents near the Lisvane line filled insulin at Lisvane retail pharmacies before the Act.",
   "p": 0.6,
   "class": "mobility"
  },
  "q9_some_covered_residents_can_defer_storabl": {
   "text": "Some covered residents can defer storable insulin purchases from late 2027 to January 2028.",
   "p": 0.65,
   "class": "other"
  },
  "q10_under_u1_b_most_state_plan_members_using": {
   "text": "Under U1-b, most state-plan members using out-of-state mail order can switch to an in-state pharmacy.",
   "p": 0.85,
   "class": "mobility"
  },
  "q11_some_insulin_users_move_into_tarrenmoor_": {
   "text": "Some insulin users move into Tarrenmoor for the cap.",
   "p": 0.2,
   "class": "mobility"
  },
  "q12_in_high_deductible_plans_only_the_member": {
   "text": "In high-deductible plans only the member's own payment counts toward the deductible, so a $35 fill counts $35, not the plan's balance.",
   "p": 0.7,
   "class": "other"
  },
  "q13_pharmacies_pbms_insurers_and_patient_gro": {
   "text": "Pharmacies, PBMs, insurers and patient groups can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q14_some_over_the_counter_human_insulin_buye": {
   "text": "Some over-the-counter human insulin buyers obtain a prescription to buy an analog at $35.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q15_some_individual_market_insulin_users_dro": {
   "text": "Some individual-market insulin users drop coverage because insulin now costs $35 without it.",
   "p": 0.4,
   "class": "substitutability"
  },
  "q16_some_members_of_self_funded_plans_or_res": {
   "text": "Some members of self-funded plans, or residents of Lisvane, attest falsely, and pharmacies cannot easily check.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q17_plans_may_and_some_do_add_prior_authoriz": {
   "text": "Plans may and some do add prior authorization or step therapy for costlier insulin products.",
   "p": 0.6,
   "class": "other"
  },
  "q18_insurers_include_the_added_outlay_in_202": {
   "text": "Insurers include the added outlay in 2028 premiums, and the insurance commissioner approves it.",
   "p": 0.8,
   "class": "other"
  },
  "q19_some_pbms_press_insulin_reimbursement_ra": {
   "text": "Some PBMs press insulin reimbursement rates down at the 2029 renewals because plans now bear what high-deductible members paid.",
   "p": 0.55,
   "class": "other"
  },
  "q20_the_contracted_rates_of_the_insulin_prod": {
   "text": "The contracted rates of the insulin products a plan can steer between differ by much less than the $54 a fill the cap shifts to plans.",
   "p": 0.75,
   "class": "other"
  },
  "q21_some_pharmacies_collect_more_than_35_and": {
   "text": "Some pharmacies collect more than $35, and some are fined.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q22_manufacturers_list_prices_respond_at_the": {
   "text": "Manufacturers' list prices respond at the margin to how many sales a higher list price loses, so a smaller loss in Tarrenmoor moves them, by a small amount.",
   "p": 0.6,
   "class": "other"
  },
  "q23_under_u1_a_some_nonresident_permit_holde": {
   "text": "Under U1-a, some nonresident permit holders with few Tarrenmoor insulin patients stop shipping insulin there rather than comply with the billing and usual-price rules.",
   "p": 0.55,
   "class": "other"
  },
  "q24_under_u1_b_a_pbm_opens_an_in_state_licen": {
   "text": "Under U1-b, a PBM opens an in-state licensed mail-order pharmacy to keep its Tarrenmoor insulin fills.",
   "p": 0.35,
   "class": "other"
  },
  "q25_manufacturers_apply_their_payer_of_last_": {
   "text": "Manufacturers apply their payer-of-last-resort clause to the Fund and drop or restrict program enrollment for Tarrenmoor residents.",
   "p": 0.6,
   "class": "other"
  },
  "q26_some_individual_market_buyers_without_pr": {
   "text": "Some individual-market buyers without premium credits are at the margin of buying coverage at a slightly higher premium.",
   "p": 0.55,
   "class": "substitutability"
  },
  "q27_some_employers_near_the_line_between_ins": {
   "text": "Some employers near the line between insured and self-funded plans convert.",
   "p": 0.55,
   "class": "other"
  },
  "q28_private_label_human_insulin_cannot_be_cu": {
   "text": "Private-label human insulin cannot be cut back at once: chains buy it under contracted volumes.",
   "p": 0.6,
   "class": "durability"
  },
  "q29_human_insulin_is_made_in_a_few_plants_wi": {
   "text": "Human insulin is made in a few plants with large fixed costs, so cost per vial rises as output contracts.",
   "p": 0.6,
   "class": "durability"
  },
  "q30_premium_tax_lost_to_employers_who_conver": {
   "text": "Premium tax lost to employers who convert and members who drop coverage is smaller than the premium tax raised by the added premiums.",
   "p": 0.8,
   "class": "other"
  }
 }
