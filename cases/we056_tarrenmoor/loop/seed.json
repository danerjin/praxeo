 "assumptions": {
  "a1": {
   "text": "Bound pharmacies comply with the $35 cap for most fills, and the payments they receive (contract rate, or the Fund's payment) exceed their acquisition cost, so they keep dispensing.",
   "p": 0.9,
   "class": "enforcement"
  },
  "a2": {
   "text": "2028 PBM contracts with pharmacies are not reopened during the year.",
   "p": 0.75,
   "class": "other"
  },
  "a4": {
   "text": "Most pharmacies have few cash insulin customers outside the Act, so they set their usual price at or near the Fund's limit.",
   "p": 0.75,
   "class": "other"
  },
  "a5": {
   "text": "The Board of Pharmacy does some enforcement work under the Act (complaints, audits of balance billing) from its existing fee-funded budget, which the Act does not raise.",
   "p": 0.8,
   "class": "revenue_use"
  },
  "a23": {
   "text": "The Act was not expected before its introduction in January 2027.",
   "p": 0.7,
   "class": "expectations"
  }
