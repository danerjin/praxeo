 "assumptions": {
  "a1": {
   "text": "Many practitioners and would-be entrants lack the degree and would not otherwise get it, so the requirement binds.",
   "p": 0.9,
   "class": "binding"
  },
  "a2": {
   "text": "The Board enforces often enough, with unenforceable contracts as a further deterrent, that many comply or stop.",
   "p": 0.7,
   "class": "enforcement"
  },
  "a3": {
   "text": "Some unlicensed practice continues undetected, mainly in homes.",
   "p": 0.8,
   "class": "enforcement"
  },
  "a5": {
   "text": "Building departments reject commercial interior plans without a stamp.",
   "p": 0.85,
   "class": "enforcement"
  },
  "q5_architects_take_on_more_commercial_inter": {
   "text": "Architects take on more commercial interior work.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q6_commercial_clients_can_bring_projects_fo": {
   "text": "Commercial clients can bring projects forward into the ten-month window.",
   "p": 0.6,
   "class": "expectations"
  },
  "q7_architects_capacity_for_interior_work_ca": {
   "text": "Architects' capacity for interior work cannot expand at unchanged fees in the medium run (they are licensed, and their own training pipeline is long).",
   "p": 0.7,
   "class": "other"
  },
  "q8_license_holders_schools_retailers_and_ar": {
   "text": "License holders, schools, retailers and architects can organize at a cost below their stake.",
   "p": 0.8,
   "class": "other"
  },
  "q9_residential_clients_have_close_exempt_or": {
   "text": "Residential clients have close exempt or unlicensed substitutes: store design help, online services, doing it themselves.",
   "p": 0.85,
   "class": "substitutability"
  },
  "q10_the_retail_exemption_can_be_used_for_ful": {
   "text": "The retail exemption can be used for full-room design given with furniture sales.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q11_velmark_based_designers_serve_arvane_hom": {
   "text": "Velmark-based designers serve Arvane homes without an Arvane license on a meaningful scale.",
   "p": 0.4,
   "class": "mobility"
  },
  "q12_some_grandfathered_designers_would_other": {
   "text": "Some grandfathered designers would otherwise leave the trade for a time and return.",
   "p": 0.65,
   "class": "other"
  },
  "q13_the_next_best_work_of_recent_designers_w": {
   "text": "The next-best work of recent designers who leave (store design jobs, other occupations) pays less in money than their design practice.",
   "p": 0.65,
   "class": "other"
  },
  "q14_some_practitioners_and_would_be_entrants": {
   "text": "Some practitioners and would-be entrants without the degree earn it to gain a license.",
   "p": 0.7,
   "class": "other"
  },
  "q15_households_that_use_a_store_s_design_hel": {
   "text": "Households that use a store's design help buy most furnishings from that store.",
   "p": 0.75,
   "class": "other"
  },
  "q16_supervision_is_costly_or_limited_per_sup": {
   "text": "Supervision is costly or limited per supervisor, so supervised positions are scarce relative to graduates in the medium run (the assumption of EN-9).",
   "p": 0.6,
   "class": "other"
  }
 }
}