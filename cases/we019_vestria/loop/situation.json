 "assumptions": {
  "a1": {
   "text": "Sellers do not capture the whole rebate by raising transaction prices, so the net price to rebate buyers falls.",
   "p": 0.85,
   "class": "other"
  },
  "a4": {
   "text": "The scrapped cars would otherwise have stayed in use for some years.",
   "p": 0.85,
   "class": "durability"
  },
  "a5": {
   "text": "Buyers knew of the scheme from March and could delay purchases.",
   "p": 0.85,
   "class": "expectations"
  },
  "a7": {
   "text": "The supply of eligible models cannot grow much within six months.",
   "p": 0.7,
   "class": "other"
  },
  "a16": {
   "text": "In the window, sellers of eligible models have clearly fewer alternatives than rebate buyers: their stock is fixed by earlier import orders, while rebate buyers can wait, keep their old car or choose a non-eligible model.",
   "p": 0.65,
   "class": "substitutability"
  },
  "j1": {
   "text": "The additional government bonds are serviced and repaid from general revenue.",
   "p": 0.95,
   "class": "other"
  },
  "j2": {
   "text": "Buyers expect the rebate to end on 31 December.",
   "p": 0.9,
   "class": "expectations"
  },
  "j3": {
   "text": "Dismantlers do not fake scrapping on a meaningful scale.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q9_repairs_parts_and_fuel_are_complements_i": {
   "text": "Repairs, parts and fuel are complements in use of cars, and repairs and parts for older models have few uses other than in older cars.",
   "p": 0.85,
   "class": "substitutability"
  },
  "q10_many_owners_of_eligible_cars_value_the_r": {
   "text": "Many owners of eligible cars value the rebate above their car and the cost of buying sooner.",
   "p": 0.9,
   "class": "other"
  },
  "q11_many_window_buyers_would_have_bought_a_n": {
   "text": "Many window buyers would have bought a new car within the next few years anyway.",
   "p": 0.85,
   "class": "expectations"
  },
  "q12_demand_for_rebates_exceeds_120_000_at_so": {
   "text": "Demand for rebates exceeds 120,000 at some point in the window.",
   "p": 0.6,
   "class": "expectations"
  },
  "q13_the_dips_consist_only_of_purchases_moved": {
   "text": "The dips consist only of purchases moved into the window: buyers do not delay later purchases to wait for a repeat scheme (the opposite of A-15).",
   "p": 0.65,
   "class": "expectations"
  },
  "q14_some_rebate_buyers_would_otherwise_have_": {
   "text": "Some rebate buyers would otherwise have bought a non-eligible new model.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q15_the_scrapped_cars_used_materially_more_f": {
   "text": "The scrapped cars used materially more fuel per km than the new cars that replace them.",
   "p": 0.9,
   "class": "other"
  },
  "q16_some_owners_of_failing_cars_can_get_a_ro": {
   "text": "Some owners of failing cars can get a roadworthiness certificate for less than the rebate is worth to them.",
   "p": 0.6,
   "class": "other"
  },
  "q17_repairing_an_existing_old_car_is_a_feasi": {
   "text": "Repairing an existing old car is a feasible alternative to replacing it for some used-car buyers.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q18_used_car_imports_cannot_quickly_replace_": {
   "text": "Used-car imports cannot quickly replace the scrapped cars.",
   "p": 0.75,
   "class": "mobility"
  },
  "q19_importers_and_dealers_can_organize_to_lo": {
   "text": "Importers and dealers can organize to lobby at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q20_dismantlers_fake_scrapping_on_a_meaningf": {
   "text": "Dismantlers fake scrapping on a meaningful scale.",
   "p": 0.25,
   "class": "enforcement"
  },
  "q21_some_used_car_buyers_can_buy_imported_us": {
   "text": "Some used-car buyers can buy imported used cars despite the duty and the registration inspection.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q22_importers_can_recertify_model_variants_b": {
   "text": "Importers can recertify model variants below 5.0 L/100 km within the window.",
   "p": 0.3,
   "class": "other"
  }
 }
