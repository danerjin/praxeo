 "assumptions": {
  "a1": {
   "text": "Without the Act, prices of covered goods and rooms would rise more than 10% above the base plus documented cost increases, for independent sellers, outside sellers and hotels, in the first weeks.",
   "class": "binding",
   "p": 0.85
  },
  "a3": {
   "text": "The Attorney General enforces actively in the declared area, including against outside sellers.",
   "class": "enforcement",
   "p": 0.75
  },
  "a14": {
   "text": "Sellers expect the cap to bind in future storms.",
   "class": "expectations",
   "p": 0.75
  },
  "a21": {
   "text": "Enforcement during a declaration is paid from the Attorney General's existing budget, which is fixed within the year; there is no supplementary appropriation.",
   "class": "revenue_use",
   "p": 0.6
  },
  "q5_households_know_the_act_and_expect_it_to": {
   "text": "Households know the Act and expect it to apply in future storms.",
   "p": 0.55,
   "class": "expectations"
  },
  "q6_stores_in_the_declared_counties_ration_s": {
   "text": "Stores in the declared counties ration scarce goods by per-customer limits and by serving regular or early customers.",
   "p": 0.8,
   "class": "other"
  },
  "q7_when_local_stores_sell_out_some_resident": {
   "text": "When local stores sell out, some residents drive between stores and look for informal sellers.",
   "p": 0.75,
   "class": "other"
  },
  "q8_some_unserved_buyers_have_substitutes_ic": {
   "text": "Some unserved buyers have substitutes (ice, relatives' homes).",
   "p": 0.8,
   "class": "substitutability"
  },
  "q9_inland_stores_can_be_reached_within_days": {
   "text": "Inland stores can be reached within days of landfall.",
   "p": 0.7,
   "class": "mobility"
  },
  "q10_a_guest_who_checks_out_loses_the_capped_": {
   "text": "A guest who checks out loses the capped room and cannot pass it on.",
   "p": 0.85,
   "class": "other"
  },
  "q11_some_outside_repair_contractors_rely_on_": {
   "text": "Some outside repair contractors rely on local rooms, and their other lodging is far away.",
   "p": 0.6,
   "class": "alternative_uses"
  },
  "q12_outside_repair_crews_have_other_work_the": {
   "text": "Outside repair crews have other work they can do (other storm areas, normal jobs elsewhere), so some are at the margin of coming.",
   "p": 0.75,
   "class": "alternative_uses"
  },
  "q13_local_sellers_expect_the_emergency_to_en": {
   "text": "Local sellers expect the emergency to end within weeks, can store durable goods, and are not required to sell.",
   "p": 0.55,
   "class": "expectations"
  },
  "q14_some_informal_sales_above_the_cap_go_und": {
   "text": "Some informal sales above the cap go undetected.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q15_bundling_new_models_and_relabeled_fees_a": {
   "text": "Bundling, new models and relabeled fees are open to some sellers.",
   "p": 0.6,
   "class": "other"
  },
  "q16_holding_extra_stock_before_the_season_is": {
   "text": "Holding extra stock before the season is costly to sellers (floor and warehouse space, money tied up, stock left unsold or marked down if no storm comes).",
   "p": 0.9,
   "class": "other"
  },
  "q17_bound_sellers_can_organize_to_lobby_at_a": {
   "text": "Bound sellers can organize to lobby at a cost lower than their stake: hotel and retail associations already exist in the state, and the Act applies in every declared emergency.",
   "p": 0.6,
   "class": "other"
  },
  "q18_hotels_may_change_services_and_stay_cond": {
   "text": "Hotels may change services and stay conditions (the Act caps the charge only).",
   "p": 0.75,
   "class": "other"
  },
  "q19_goods_that_could_be_brought_in_can_be_so": {
   "text": "Goods that could be brought in can be sold elsewhere at normal prices.",
   "p": 0.9,
   "class": "alternative_uses"
  },
  "q20_as_the_attorney_general_applies_k2_the_e": {
   "text": "As the Attorney General applies K2, the extra costs of an emergency trip (own time, risk, unsold stock, value elsewhere) are mostly not accepted as documented costs.",
   "p": 0.75,
   "class": "alternative_uses"
  }
 }
}