 "assumptions": {
  "a1": {
   "text": "Without the quota, Calvar would keep importing well over 350,000 tonnes a year, so the quota binds from the first year, and more tightly as demand grows.",
   "p": 0.95,
   "class": "binding"
  },
  "a2": {
   "text": "Customs enforces the quota at the ports.",
   "p": 0.85,
   "class": "enforcement"
  },
  "a6": {
   "text": "Importers know the allocation formula during the window and can finance and store extra imports.",
   "p": 0.8,
   "class": "expectations"
  },
  "a8": {
   "text": "Importing blends and syrups with 65% sugar or less is technically and commercially workable for some users.",
   "p": 0.6,
   "class": "other"
  },
  "a12": {
   "text": "Bulk sugar is smuggled on a meaningful scale.",
   "p": 0.3,
   "class": "enforcement"
  },
  "a22": {
   "text": "The customs budget is raised to cover inspection of bulk shipments and the register of quota rights.",
   "p": 0.7,
   "class": "revenue_use"
  },
  "q7_corn_syrup_and_other_sweeteners_are_acce": {
   "text": "Corn syrup and other sweeteners are acceptable substitutes for sugar in some uses, above all soft drinks.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q8_enough_varnholt_residents_shop_in_ostria": {
   "text": "Enough Varnholt residents shop in Ostria within the personal allowance.",
   "p": 0.7,
   "class": "mobility"
  },
  "q9_domestic_beet_sugar_and_refined_imported": {
   "text": "Domestic beet sugar and refined imported sugar are close substitutes for buyers.",
   "p": 0.9,
   "class": "substitutability"
  },
  "q10_land_and_labor_can_move_from_other_field": {
   "text": "Land and labor can move from other field crops into beet within one or two seasons, and the beet factories have some spare capacity.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q11_corn_syrup_output_cannot_expand_at_once_": {
   "text": "Corn syrup output cannot expand at once because the mills are near capacity.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q12_makers_of_locally_made_sweetened_goods_c": {
   "text": "Makers of locally made sweetened goods compete mainly with each other, all face the dearer sugar, and cannot fully switch to other sweeteners.",
   "p": 0.85,
   "class": "other"
  },
  "q13_buyers_demand_for_sugar_and_sweeteners_t": {
   "text": "Buyers' demand for sugar and sweeteners taken together is inelastic enough that their total spending on them rises.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q14_growers_quota_holders_and_manufacturers_": {
   "text": "Growers, quota holders and manufacturers can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q15_holders_growers_and_landowners_expect_th": {
   "text": "Holders, growers and landowners expect the quota to survive the five-year review.",
   "p": 0.65,
   "class": "expectations"
  },
  "q16_calvar_s_sugar_imports_come_from_many_co": {
   "text": "Calvar's sugar imports come from many competing foreign sellers, and no exporting country administers a share of the quota (the assumption of DM-4).",
   "p": 0.8,
   "class": "expectations"
  },
  "q17_lower_imports_are_not_offset_by_capital_": {
   "text": "Lower imports are not offset by capital flows or other adjustments within the medium horizon (the assumption of TX-8).",
   "p": 0.6,
   "class": "other"
  },
  "q18_blends_and_syrups_at_or_below_the_65_lin": {
   "text": "Blends and syrups at or below the 65% line can serve only some users, so imports in that form cannot replace all the sugar the quota keeps out.",
   "p": 0.85,
   "class": "substitutability"
  },
  "q19_varnholt_shoppers_buy_other_groceries_on": {
   "text": "Varnholt shoppers buy other groceries on the same trips as sugar.",
   "p": 0.7,
   "class": "other"
  },
  "q20_when_sugar_is_counted_against_dry_weight": {
   "text": "When sugar is counted against dry weight, a narrower range of blends and syrups still falls at or below the 65% line.",
   "p": 0.75,
   "class": "other"
  },
  "q21_the_port_refineries_cannot_replace_impor": {
   "text": "The port refineries cannot replace imported raw cane with domestic beet.",
   "p": 0.9,
   "class": "other"
  },
  "q22_the_value_of_the_free_quota_shares_to_th": {
   "text": "The value of the free quota shares to their holders far exceeds their cost of compliance.",
   "p": 0.9,
   "class": "other"
  },
  "q23_imported_confectionery_biscuits_and_soft": {
   "text": "Imported confectionery, biscuits and soft drinks are close substitutes for Calvarian ones and enter freely.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q24_food_plants_last_15_to_25_years_so_reloc": {
   "text": "Food plants last 15 to 25 years, so relocation happens mainly through new investment.",
   "p": 0.9,
   "class": "durability"
  },
  "q25_the_port_refineries_imported_their_raw_c": {
   "text": "The port refineries imported their raw cane as importers of record in the base period, and so receive large quota shares.",
   "p": 0.8,
   "class": "other"
  }
 }
}