  {"component": "k1", "exchange": "e_imp_empty", "payer_side": "buyer", "receiver": "officials.enforcement", "receipt_variable": "tax_revenue", "projection_variable": "tax_revenue_vs_static_projection"},
  {"component": "k1", "exchange": "e_imp_goods", "payer_side": "buyer", "receiver": "officials.enforcement", "receipt_variable": "tax_revenue", "projection_variable": "tax_revenue_vs_static_projection"},
  {"component": "k1", "exchange": "e_export", "payer_side": "seller", "receiver": "officials.enforcement", "receipt_variable": "tax_revenue", "projection_variable": "tax_revenue_vs_static_projection"}
 ],
