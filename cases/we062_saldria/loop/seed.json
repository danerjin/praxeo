 "funded": [{"component": "k4", "actor": "taxpayers", "premises": ["a24"]}],
 "assumptions": {
  "a2": {"text": "Imported empty packaging is at the margin of supply for most kinds of packaging, and foreign converters, with many other markets, absorb little of the tax, so packaging users bear more of it than sellers do.", "class": "substitutability", "p": 0.75},
  "a12": {"text": "Exporters of empty packaging and packaged goods sell at prices set abroad.", "class": "substitutability", "p": 0.8},
  "s1": {"text": "Foreign sellers of packaged goods, with many other markets, absorb little of the tax on the packaging around their goods.", "class": "substitutability", "p": 0.7},
  "s2": {"text": "Firms expect the tax to take effect on 1 January 2028 as enacted.", "class": "expectations", "p": 0.95},
  "a24": {"text": "The plastics unit is funded by the 7 million T appropriation in the Act, from the general budget that receives the tax.", "class": "revenue_use", "p": 0.9}
 }
