 "assumptions": {
  "a2": {
   "text": "Imported empty packaging is at the margin of supply for most kinds of packaging, and foreign converters, with many other markets, absorb little of the tax, so packaging users bear more of it than sellers do.",
   "class": "substitutability",
   "p": 0.75
  },
  "a12": {
   "text": "Exporters of empty packaging and packaged goods sell at prices set abroad.",
   "class": "substitutability",
   "p": 0.8
  },
  "s1": {
   "text": "Foreign sellers of packaged goods, with many other markets, absorb little of the tax on the packaging around their goods.",
   "class": "substitutability",
   "p": 0.7
  },
  "s2": {
   "text": "Firms expect the tax to take effect on 1 January 2028 as enacted.",
   "class": "expectations",
   "p": 0.95
  },
  "a24": {
   "text": "The plastics unit is funded by the 7 million T appropriation in the Act, from the general budget that receives the tax.",
   "class": "revenue_use",
   "p": 0.9
  },
  "q6_some_plastic_components_can_be_redesigne": {
   "text": "Some plastic components can be redesigned so that another material (board, paper, metal) is the heaviest by weight, at a cost below the tax saved.",
   "p": 0.65,
   "class": "other"
  },
  "q7_for_some_components_raising_recycled_con": {
   "text": "For some components, raising recycled content to 30% costs less than the tax.",
   "p": 0.85,
   "class": "other"
  },
  "q8_some_components_can_be_made_lighter_at_a": {
   "text": "Some components can be made lighter at a cost below the tax saved.",
   "p": 0.75,
   "class": "other"
  },
  "q9_misdeclaring_recycled_content_or_weight_": {
   "text": "Misdeclaring recycled content or weight costs some firms less than the tax, given audits and penalties.",
   "p": 0.6,
   "class": "other"
  },
  "q10_some_exporters_can_replace_export_fillin": {
   "text": "Some exporters can replace export filling or converting lines abroad when they come up for replacement.",
   "p": 0.55,
   "class": "other"
  },
  "q11_converters_multi_product_users_and_recyc": {
   "text": "Converters, multi-product users and recyclers can organize to lobby on U1 and the rules at a cost below their stake.",
   "p": 0.8,
   "class": "other"
  },
  "q12_converters_adjust_labor_to_output": {
   "text": "Converters adjust labor to output.",
   "p": 0.8,
   "class": "other"
  },
  "q13_investors_expect_the_tax_and_its_exempti": {
   "text": "Investors expect the tax, and its exemption, to last at least several years.",
   "p": 0.8,
   "class": "other"
  },
  "q14_converters_can_buy_equipment_that_lets_t": {
   "text": "Converters can buy equipment that lets them process recycled resin, and expect the exemption to last long enough to pay for it.",
   "p": 0.7,
   "class": "other"
  },
  "q15_recycled_resin_takes_the_place_of_virgin": {
   "text": "Recycled resin takes the place of virgin resin in the components that use it.",
   "p": 0.9,
   "class": "other"
  },
  "q16_paper_and_board_glass_and_metal_packagin": {
   "text": "Paper and board, glass and metal packaging serve some of the same ends as plastic for some users.",
   "p": 0.8,
   "class": "other"
  },
  "q17_recycled_resin_delivered_in_saldria_can_": {
   "text": "Recycled resin delivered in Saldria can expand only at a higher cost: collection and sorting are near capacity, added collection reaches more dispersed sources and dirtier bales, and regional resin costs more (C-30); the cost per tonne does not fall as supply expands within the medium run.",
   "p": 0.7,
   "class": "other"
  },
  "q18_converting_plants_are_specific_to_plasti": {
   "text": "Converting plants are specific to plastic converting and cannot move to other uses without large losses.",
   "p": 0.8,
   "class": "other"
  },
  "q19_some_firms_that_would_handle_10_to_13_t_": {
   "text": "Some firms that would handle 10 to 13 t can keep under 10 t at a cost below the notch (2,000 T of tax and 2,500 to 4,000 T of compliance a year).",
   "p": 0.7,
   "class": "other"
  },
  "q20_moving_the_importer_of_record_to_unrelat": {
   "text": "Moving the importer of record to unrelated parties (customers, foreign sellers who register) is cheap enough for some near-line firms.",
   "p": 0.4,
   "class": "other"
  },
  "q21_liable_firms_can_store_packaging_and_bri": {
   "text": "Liable firms can store packaging and bring orders forward into late 2027.",
   "p": 0.75,
   "class": "other"
  },
  "q22_packaging_is_a_material_part_of_the_cost": {
   "text": "Packaging is a material part of the cost of some packaged goods (6% to 10% for bottled water and pre-packed produce), and their sellers cannot switch fully at the old cost.",
   "p": 0.75,
   "class": "other"
  },
  "q23_goods_imported_by_small_importers_compet": {
   "text": "Goods imported by small importers compete with goods packaged or imported by liable firms.",
   "p": 0.65,
   "class": "other"
  },
  "q24_changes_in_imports_and_exports_are_not_o": {
   "text": "Changes in imports and exports are not offset by capital flows within the medium run.",
   "p": 0.6,
   "class": "other"
  },
  "q25_some_users_under_10_t_can_import_their_o": {
   "text": "Some users under 10 t can import their own packaging at a cost below the tax they would pay on domestic packaging.",
   "p": 0.55,
   "class": "other"
  },
  "q26_board_and_glass_container_supply_cannot_": {
   "text": "Board and glass container supply cannot expand at an unchanged cost within the first year.",
   "p": 0.7,
   "class": "other"
  },
  "q27_loose_produce_and_tap_or_refill_water_se": {
   "text": "Loose produce and tap or refill water serve the same ends as pre-packed produce and bottled water for some buyers.",
   "p": 0.8,
   "class": "other"
  },
  "q28_export_industries_adjust_their_labor_to_": {
   "text": "Export industries adjust their labor to their output.",
   "p": 0.8,
   "class": "other"
  },
  "q29_exporters_of_packaged_goods_adjust_their": {
   "text": "Exporters of packaged goods adjust their labor to their output.",
   "p": 0.8,
   "class": "other"
  },
  "q30_the_shift_of_small_users_to_direct_impor": {
   "text": "The shift of small users to direct imports is smaller than the fall in liable firms' imports of empty packaging.",
   "p": 0.65,
   "class": "other"
  },
  "q31_recyclers_and_substitute_makers_adjust_t": {
   "text": "Recyclers and substitute makers adjust their labor to their sales.",
   "p": 0.75,
   "class": "other"
  },
  "q32_municipalities_can_extend_collection_and": {
   "text": "Municipalities can extend collection and sell more bales at the higher price.",
   "p": 0.7,
   "class": "other"
  },
  "q33_some_components_above_30_recycled_on_the": {
   "text": "Some components above 30% recycled on the counterfactual path carry that content at a margin chosen on cost, so that a dearer recycled resin leads their makers to cut it toward 30%.",
   "p": 0.6,
   "class": "other"
  }
 }
}