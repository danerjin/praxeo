 "assumptions": {
  "a1": {
   "text": "The Act is in force for 2028 to 2032 and payments are made as it provides.",
   "p": 0.9,
   "class": "enforcement"
  },
  "a2": {
   "text": "The national average price falls below Th 220 in at least one of the five crop years.",
   "p": 0.85,
   "class": "other"
  },
  "a10": {
   "text": "The domestic farm-gate price follows export parity in every year (Brisklund exports in every year).",
   "p": 0.9,
   "class": "other"
  },
  "a11": {
   "text": "Land buyers expected the Act from February 2027 and expect it to run its term, with some chance of renewal.",
   "p": 0.8,
   "class": "expectations"
  },
  "a18": {
   "text": "The effect of Brisklund's added output on the world price is far smaller than the expected payment per tonne.",
   "p": 0.9,
   "class": "other"
  },
  "q6_farm_unions_millers_and_holders_of_estab": {
   "text": "Farm unions, millers and holders of established production can organize at a cost below their stakes.",
   "p": 0.9,
   "class": "other"
  },
  "q7_land_can_be_moved_between_wheat_and_othe": {
   "text": "Land can be moved between wheat and other crops from year to year.",
   "p": 0.9,
   "class": "alternative_uses"
  },
  "q8_some_pasture_or_other_land_can_be_conver": {
   "text": "Some pasture or other land can be converted to wheat.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q9_some_growers_who_now_buy_put_options_or_": {
   "text": "Some growers who now buy put options or forward sales for price cover buy less.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q10_some_growers_switch_to_high_yield_feed_v": {
   "text": "Some growers switch to high-yield feed varieties when every tonne is paid alike.",
   "p": 0.6,
   "class": "other"
  },
  "q11_declarations_are_checked_only_by_samplin": {
   "text": "Declarations are checked only by sampling, so some growers overstate or declare bought grain as their own.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q12_the_payments_office_s_sampling_finds_som": {
   "text": "The payments office's sampling finds some false declarations, and repayments and fines are collected.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q13_some_growers_at_the_margin_sow_more_whea": {
   "text": "Some growers at the margin sow more wheat, or grow it more intensively, when the expected price including the payment rises.",
   "p": 0.85,
   "class": "substitutability"
  },
  "q14_land_has_fewer_alternatives_than_tenants": {
   "text": "Land has fewer alternatives than tenants' labor and machinery, and leases are let competitively.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q15_most_leases_come_up_for_renewal_within_t": {
   "text": "Most leases come up for renewal within the five-year term.",
   "p": 0.85,
   "class": "durability"
  },
  "q16_wheat_land_with_history_is_in_fixed_supp": {
   "text": "Wheat land with history is in fixed supply in the short run, and converting other land to wheat does not get cheaper per hectare as more is converted.",
   "p": 0.8,
   "class": "durability"
  },
  "q17_lenders_lower_rates_to_wheat_growers_who": {
   "text": "Lenders lower rates to wheat growers whose income in low-price years is now higher.",
   "p": 0.6,
   "class": "other"
  },
  "q18_the_cost_to_growers_of_making_claims_and": {
   "text": "The cost to growers of making claims and declarations is far smaller than the payments they receive.",
   "p": 0.9,
   "class": "other"
  },
  "q19_under_u1_b_some_land_that_would_have_lef": {
   "text": "Under U1-b, some land that would have left farming is kept registered, and some of it grows wheat.",
   "p": 0.35,
   "class": "other"
  },
  "q20_the_payment_on_established_production_go": {
   "text": "The payment on established production goes to the holder registered as farming the land, so the claim passes with the farm.",
   "p": 0.8,
   "class": "expectations"
  },
  "q21_the_rise_in_wheat_exports_is_not_offset_": {
   "text": "The rise in wheat exports is not offset by capital flows in the medium run.",
   "p": 0.55,
   "class": "other"
  },
  "q22_the_repayments_and_fines_collected_are_f": {
   "text": "The repayments and fines collected are far smaller than the payments made.",
   "p": 0.9,
   "class": "other"
  },
  "q23_feed_buyers_substitute_between_feed_whea": {
   "text": "Feed buyers substitute between feed wheat and feed barley of a given quality.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q24_foreign_growers_cost_per_tonne_does_not_": {
   "text": "Foreign growers' cost per tonne does not rise as their output contracts (the land given up is the least productive; costs are not mainly fixed per farm), and they cannot contract at once.",
   "p": 0.85,
   "class": "other"
  }
 }
}