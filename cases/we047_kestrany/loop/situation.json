 "assumptions": {
  "a1": {
   "text": "At the old landed price (about $550 a tonne, white), demand for imports would exceed 400,000 t.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Customs enforce the out-of-quota rate and licence limits.",
   "class": "enforcement",
   "p": 0.85
  },
  "a4": {
   "text": "Foreign supply comes from many competing exporters, and no exporting country administers a share of the quota.",
   "class": "other",
   "p": 0.85
  },
  "a10": {
   "text": "Sugar can be imported ahead in 2026 at 25% and stored into 2027, and is expected to sell higher after January.",
   "class": "expectations",
   "p": 0.85
  },
  "a19": {
   "text": "Some licence volume is left unused and unsold on 30 September each year.",
   "class": "other",
   "p": 0.6
  },
  "a20": {
   "text": "Under U1-a, applications for surrendered quantities exceed them, and the Minister's rules allocate them otherwise than by price.",
   "class": "other",
   "p": 0.65
  },
  "a27": {
   "text": "The licence office's budget is raised with its task.",
   "class": "revenue_use",
   "p": 0.6
  },
  "a32": {
   "text": "The licence office's running cost exceeds the registration and transfer fees it receives.",
   "class": "other",
   "p": 0.85
  },
  "j_reg": {
   "text": "Every firm that imports sugar must register as an importer for $500.",
   "class": "enforcement",
   "p": 0.9
  },
  "j_fee": {
   "text": "Transfers of shares and licences must be registered with the licence office for a $200 fee.",
   "class": "enforcement",
   "p": 0.9
  },
  "j_inc": {
   "text": "Exporters can sell the sugar that Kestrany does not buy to other buyers in the world market.",
   "class": "substitutability",
   "p": 0.9
  },
  "q12_out_of_quota_imports_stay_below_200_000_": {
   "text": "Out-of-quota imports stay below 200,000 t a year.",
   "p": 0.85,
   "class": "other"
  },
  "q13_domestic_supply_cannot_expand_at_the_old": {
   "text": "Domestic supply cannot expand at the old cost enough to replace the cut imports within five years (the response is partial).",
   "p": 0.8,
   "class": "durability"
  },
  "q14_the_cost_of_the_marginal_domestic_tonne_": {
   "text": "The cost of the marginal domestic tonne does not fall as domestic output expands (constant or rising cost).",
   "p": 0.85,
   "class": "durability"
  },
  "q15_the_change_in_imports_is_not_offset_by_c": {
   "text": "The change in imports is not offset by capital flows within the medium term.",
   "p": 0.6,
   "class": "other"
  },
  "q16_licences_and_shares_trade_and_lease_at_l": {
   "text": "Licences and shares trade and lease at low cost.",
   "p": 0.8,
   "class": "mobility"
  },
  "q17_some_sugar_can_be_imported_as_mixtures_c": {
   "text": "Some sugar can be imported as mixtures classified outside the sugar heading at a lower duty.",
   "p": 0.6,
   "class": "other"
  },
  "q18_licence_holders_growers_manufacturers_an": {
   "text": "Licence holders, growers, manufacturers and would-be importers can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q19_for_the_importing_firms_the_quota_rent_f": {
   "text": "For the importing firms, the quota rent far exceeds the trading margin on the volume they lose.",
   "p": 0.85,
   "class": "other"
  },
  "q20_investors_expect_the_act_to_last_at_leas": {
