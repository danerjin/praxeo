  "a1": {
   "text": "Most retailers comply, chains in particular.",
   "p": 0.85,
   "class": "enforcement"
  },
  "s2": {
   "text": "The paper bag charge is kept by the retailer.",
   "p": 0.97,
   "class": "other"
  },
  "s3": {
   "text": "The Office of Sustainability is funded from the general budget.",
   "p": 0.95,
   "class": "other"
  },
  "s4": {
   "text": "Shoppers and retailers expect the ordinance to take effect.",
   "p": 0.95,
   "class": "expectations"
  },
  "q5_thick_plastic_reusable_bags_can_be_sold_": {
   "text": "Thick plastic \"reusable\" bags can be sold cheaply at the till, and shoppers buy them.",
   "p": 0.6,
   "class": "other"
  },
  "q6_some_small_stores_keep_handing_out_thin_": {
   "text": "Some small stores keep handing out thin bags, or waive the fee, without being caught.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q7_bag_makers_and_retailers_can_organize_at": {
   "text": "Bag makers and retailers can organize at a cost below their stake.",
   "p": 0.7,
   "class": "other"
  },
  "q8_stores_near_the_line_adjust_staff_hours_": {
   "text": "Stores near the line adjust staff hours and hiring to their sales.",
   "p": 0.8,
   "class": "alternative_uses"
  },
  "q9_the_ban_moves_retailers_to_reclassify_mo": {
   "text": "The ban moves retailers to reclassify more than the fee moves them to reclassify less.",
   "p": 0.7,
   "class": "other"
  },
  "q10_many_households_reused_carryout_bags_as_": {
   "text": "Many households reused carryout bags as liners and will buy liners instead.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q11_shoppers_accept_reusable_and_paper_bags_": {
   "text": "Shoppers accept reusable and paper bags as substitutes.",
   "p": 0.95,
   "class": "substitutability"
  },
  "q12_some_shoppers_near_route_9_are_close_to_": {
   "text": "Some shoppers near Route 9 are close to indifferent between stores on either side of the line.",
   "p": 0.55,
   "class": "mobility"
  },
  "q13_a_shopper_who_changes_store_moves_the_wh": {
   "text": "A shopper who changes store moves the whole basket, since the fee applies per trip.",
   "p": 0.9,
   "class": "mobility"
  },
  "q14_shoppers_take_extra_free_bags_in_the_ann": {
   "text": "Shoppers take extra free bags in the announcement window.",
   "p": 0.7,
   "class": "expectations"
  },
  "q15_brennick_s_demand_is_large_enough_to_mov": {
   "text": "Brennick's demand is large enough to move the price of liners or reusable bags.",
   "p": 0.1,
   "class": "other"
  }
 }
