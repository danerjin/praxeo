 "assumptions": {
  "a1": {
   "text": "Money wages are fixed for most workers for the first year (agreements, custom, reluctance to cut).",
   "class": "other",
   "p": 0.85
  },
  "a8": {
   "text": "Over the long run, employers have better alternatives to hiring formal labor than most workers have to formal employment.",
   "class": "mobility",
   "p": 0.75
  },
  "a9": {
   "text": "The minimum wage plus contribution exceeds what employers will pay for some workers' labor.",
   "class": "binding",
   "p": 0.75
  },
  "a12": {
   "text": "Workers do not value the contribution as payment for a benefit.",
   "class": "other",
   "p": 0.9
  },
  "q5_employers_can_adjust_hiring_and_hours_at": {
   "text": "Employers can adjust hiring and hours at the margin.",
   "p": 0.85,
   "class": "alternative_uses"
  },
  "q6_some_work_can_be_reshaped_as_self_employ": {
   "text": "Some work can be reshaped as self-employed contracts without much risk of reclassification by the Inspectorate.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q7_labor_saving_equipment_and_outsourcing_a": {
   "text": "Labor-saving equipment and outsourcing are available for some tasks.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q8_some_employers_and_workers_can_move_part": {
   "text": "Some employers and workers can move part of pay into meal vouchers (up to 150 crowns a month) or employer-paid health insurance premiums at little loss in value to the worker.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q9_employers_move_whole_operations_abroad_w": {
   "text": "Employers move whole operations abroad within five years.",
   "p": 0.35,
   "class": "mobility"
  },
  "q10_enforcement_against_undeclared_work_is_w": {
   "text": "Enforcement against undeclared work is weak enough that some firms expand it, and penalties for it are enforced at least sometimes.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q11_employer_associations_and_unions_organiz": {
   "text": "Employer associations and unions organize.",
   "p": 0.8,
   "class": "other"
  },
  "q12_labor_intensive_service_firms_face_compe": {
   "text": "Labor-intensive service firms face competitors with the same cost increase, so they can raise prices.",
   "p": 0.75,
   "class": "other"
  },
  "q13_labor_intensive_service_firms_cannot_rep": {
   "text": "Labor-intensive service firms cannot replace labor at its old cost within the short to medium run; labor is a material part of their costs.",
   "p": 0.85,
   "class": "other"
  },
  "q14_employers_can_move_bonus_payments_into_j": {
   "text": "Employers can move bonus payments into June.",
   "p": 0.7,
   "class": "other"
  },
  "q15_the_general_budget_transfer_to_the_pensi": {
   "text": "The general-budget transfer to the pension fund is cut by part of the new revenue.",
   "p": 0.75,
   "class": "revenue_use"
  }
 }
