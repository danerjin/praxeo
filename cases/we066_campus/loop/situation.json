 "assumptions": {
  "a1": {
   "text": "The rule is enforced at the gates: most students who ride or park an e-bike on the grounds are detected within days.",
   "p": 0.8,
   "class": "enforcement"
  },
  "a10": {
   "text": "Some students ride or park on the grounds anyway.",
   "p": 0.65,
   "class": "enforcement"
  },
  "a20": {
   "text": "The school's staff budget for 2027 is fixed and gate duty is drawn from other duties.",
   "p": 0.85,
   "class": "revenue_use"
  },
  "a31": {
   "text": "The school raises its fees for 2027-28 because of the gate duty.",
   "p": 0.25,
   "class": "revenue_use"
  },
  "a_ann": {
   "text": "Families expect the rule to take effect on 19 April 2027.",
   "p": 0.95,
   "class": "expectations"
  },
  "a21": {
   "text": "Some parents rank a campus without student e-bikes above one with them, enough to change their choice of school or to stay.",
   "p": 0.55,
   "class": "other"
  },
  "a41": {
   "text": "Under U1-b, some parents rank a campus without throttle e-bikes above one with them, enough to change their choice of school or to stay.",
   "p": 0.5,
   "class": "other"
  },
  "q8_the_student_council_safe_lanes_and_ride_": {
   "text": "The student council, Safe Lanes and Ride to School can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q9_without_the_rule_the_question_of_a_ban_w": {
   "text": "Without the rule, the question of a ban would have stayed contested in 2027-28.",
   "p": 0.75,
   "class": "other"
  },
  "q10_some_e_bike_riders_switch_to_a_pedal_bic": {
   "text": "Some e-bike riders switch to a pedal bicycle.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q11_some_e_bike_riders_switch_to_the_school_": {
   "text": "Some e-bike riders switch to the school coach.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q12_some_e_bike_riders_switch_to_route_14": {
   "text": "Some e-bike riders switch to route 14.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q13_some_families_choose_to_drive_at_today_s": {
   "text": "Some families choose to drive, at today's queue time (the response is partial).",
   "p": 0.8,
   "class": "substitutability"
  },
  "q14_some_e_bike_riders_switch_to_e_scooters_": {
   "text": "Some e-bike riders switch to e-scooters, which section 14 of the Behaviour Code lets them carry in folded.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q15_some_riders_keep_riding_and_park_off_sch": {
   "text": "Some riders keep riding and park off school land near the gates.",
   "p": 0.85,
   "class": "mobility"
  },
  "q16_some_e_bike_riders_switch_to_walking": {
   "text": "Some e-bike riders switch to walking.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q17_some_students_sell_their_e_bikes_because": {
   "text": "Some students sell their e-bikes because the rule removes their main use, some of them before 19 April.",
   "p": 0.7,
   "class": "expectations"
  },
  "q18_some_families_who_live_far_away_and_reli": {
   "text": "Some families who live far away and relied on e-bikes rank the school lower, enough to change their choice.",
   "p": 0.55,
   "class": "other"
  },
  "q19_holders_of_e_bikes_and_of_rentable_drive": {
   "text": "Holders of e-bikes and of rentable driveways expect the rule to last at least until the June 2028 review.",
   "p": 0.7,
   "class": "expectations"
  },
  "q20_some_students_would_have_bought_an_e_bik": {
   "text": "Some students would have bought an e-bike in the next year.",
   "p": 0.8,
   "class": "other"
  },
  "q21_under_u1_b_some_throttle_riders_remove_t": {
   "text": "Under U1-b, some throttle riders remove the throttle or swap for a pedal-assist bike at a cost below the rule's burden.",
   "p": 0.7,
   "class": "other"
  },
  "q22_some_of_the_e_bikes_students_would_have_": {
   "text": "Some of the e-bikes students would have bought are bought from the two local shops.",
   "p": 0.9,
   "class": "other"
  },
  "q23_some_e_bike_riders_who_switch_to_the_sch": {
   "text": "Some e-bike riders who switch to the school coach find a free seat.",
   "p": 0.85,
   "class": "other"
  },
  "q24_on_routes_3_and_4_applicants_for_seats_a": {
   "text": "On routes 3 and 4, applicants for seats at the fixed pass price exceed the seats in the Summer term.",
   "p": 0.6,
   "class": "binding"
  },
  "q25_marrick_cannot_add_a_coach_on_routes_3_a": {
   "text": "Marrick cannot add a coach on routes 3 and 4 within the Summer term.",
   "p": 0.7,
   "class": "binding"
  },
  "q26_marrick_adds_a_coach_on_routes_3_and_4_f": {
   "text": "Marrick adds a coach on routes 3 and 4 from September 2027 at the contract renewal.",
   "p": 0.6,
   "class": "alternative_uses"
  },
  "q27_the_coach_contractor_s_cost_of_an_added_": {
   "text": "The coach contractor's cost of an added coach on routes 3 and 4 raises the 2027-28 pass price.",
   "p": 0.45,
   "class": "other"
  },
  "q28_for_families_who_switch_to_a_pass_or_a_c": {
   "text": "For families who switch to a pass or a car run, the added outlay exceeds the e-bike running costs they save.",
   "p": 0.85,
   "class": "other"
  },
  "q29_route_14_has_seats_free_for_the_added_ri": {
   "text": "Route 14 has seats free for the added riders.",
   "p": 0.85,
   "class": "other"
  },
  "q30_some_route_14_term_passes_bought_by_swit": {
   "text": "Some route 14 term passes bought by switching students are bought at Dunnock News rather than at the bus station.",
   "p": 0.6,
   "class": "other"
  },
  "q31_more_cars_at_8_15_to_8_45_lengthen_the_q": {
   "text": "More cars at 8:15 to 8:45 lengthen the queue on Quarry Lane, and any diversion of through traffic does not fully offset it.",
   "p": 0.85,
   "class": "other"
  },
  "q32_at_a_given_number_of_school_cars_the_que": {
   "text": "At a given number of school cars, the queue is no longer than without the rule: the school does not change the loop or drop-off times in the Summer term, and the rule adds no other traffic.",
   "p": 0.65,
   "class": "other"
  },
  "q33_the_longer_queue_delays_the_coaches_whic": {
   "text": "The longer queue delays the coaches, which use Quarry Lane to reach the coach bay.",
   "p": 0.75,
   "class": "other"
  },
  "q34_some_students_e_scooters_are_bought_from": {
   "text": "Some students' e-scooters are bought from the two local shops.",
   "p": 0.6,
   "class": "other"
  },
  "q35_the_supply_of_pedal_bicycles_and_e_scoot": {
   "text": "The supply of pedal bicycles and e-scooters to Wendlemere is not perfectly elastic within the Summer term.",
   "p": 0.6,
   "class": "durability"
  },
  "q36_off_site_parkers_exceed_the_free_council": {
   "text": "Off-site parkers exceed the free council stands.",
   "p": 0.8,
   "class": "binding"
  },
  "q37_some_riders_lock_bikes_to_railings_and_l": {
   "text": "Some riders lock bikes to railings and lamp posts against the by-law.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q38_some_residents_or_shopkeepers_complain_a": {
   "text": "Some residents or shopkeepers complain about bikes locked to street furniture, so that the council acts on the by-law.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q39_some_residents_of_linnet_close_and_orcha": {
   "text": "Some residents of Linnet Close and Orchard Row rent driveway or garage space for e-bikes.",
   "p": 0.55,
   "class": "other"
  },
  "q40_some_off_site_parkers_rent_a_space_in_sp": {
   "text": "Some off-site parkers rent a space in Spokewright's yard.",
   "p": 0.6,
   "class": "other"
  },
  "q41_some_students_who_park_at_the_parade_buy": {
   "text": "Some students who park at the parade buy there on the same trip.",
   "p": 0.6,
   "class": "other"
  },
  "q42_students_who_park_at_the_parade_buy_brea": {
   "text": "Students who park at the parade buy breakfast or snacks there instead of at the school canteen.",
   "p": 0.4,
   "class": "other"
  },
  "q43_bikes_locked_on_the_footways_narrow_them": {
   "text": "Bikes locked on the footways narrow them for pedestrians.",
   "p": 0.6,
   "class": "other"
  },
  "q44_for_most_riders_who_switch_to_a_coach_ro": {
   "text": "For most riders who switch to a coach, route 14, a pedal bicycle or walking, or who park outside and walk in, the trip takes longer door to door.",
   "p": 0.8,
   "class": "other"
  },
  "q45_some_students_pedal_bicycles_are_bought_": {
   "text": "Some students' pedal bicycles are bought from the two local shops.",
   "p": 0.7,
   "class": "other"
  },
  "q46_most_student_sellers_sell_in_the_local_m": {
   "text": "Most student sellers sell in the local market, and its buyers do not absorb the added listings at an unchanged price.",
   "p": 0.65,
   "class": "substitutability"
  },
  "q47_some_local_buyers_who_would_have_bought_": {
   "text": "Some local buyers who would have bought a new pedal bicycle or e-scooter buy a cheaper used e-bike instead.",
   "p": 0.5,
   "class": "substitutability"
  },
  "q48_under_u1_b_some_buyers_who_want_a_pedal_": {
   "text": "Under U1-b, some buyers who want a pedal-assist bike buy a used throttle e-bike, made cheaper by students' listings, and remove its throttle.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q49_some_staff_are_at_the_margin_of_buying_a": {
   "text": "Some staff are at the margin of buying a used e-bike, so that a lower used price draws one more staff e-bike commute.",
   "p": 0.35,
   "class": "other"
  },
  "q50_some_staff_who_drive_switch_to_e_bikes_b": {
   "text": "Some staff who drive switch to e-bikes because the shelters are emptier and the queue is longer.",
   "p": 0.5,
   "class": "other"
  },
  "q51_some_leavers_and_upgraders_who_would_hav": {
   "text": "Some leavers and upgraders who would have sold their e-bikes in July to September sell before or during the Summer term instead.",
   "p": 0.6,
   "class": "expectations"
  }
 }
