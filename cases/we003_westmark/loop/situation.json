 "assumptions": {
  "a1": {
   "text": "Few current braiders already hold a cosmetology license, so the requirement binds.",
   "p": 0.95,
   "class": "binding"
  },
  "a2": {
   "text": "The board enforces the requirement often enough that many braiders comply or stop.",
   "p": 0.7,
   "class": "enforcement"
  },
  "a3": {
   "text": "Some braiders keep working without a license and are not caught.",
   "p": 0.8,
   "class": "enforcement"
  },
  "a8": {
   "text": "The board's budget is raised for the new enforcement task (appropriation and fees), rather than the task being absorbed within a fixed budget.",
   "p": 0.6,
   "class": "revenue_use"
  },
  "a10": {
   "text": "Some current braiders or new entrants choose to obtain the full license.",
   "p": 0.8,
   "class": "alternative_uses"
  },
  "a11": {
   "text": "With fewer braiders offering legal braiding, customers pay a higher price for it.",
   "p": 0.7,
   "class": "other"
  },
  "a12": {
   "text": "The board absorbs the new enforcement task within a fixed budget, so its other work gives way.",
   "p": 0.4,
   "class": "revenue_use"
  },
  "q8_home_braiding_by_family_or_friends_is_a_": {
   "text": "Home braiding by family or friends is a feasible substitute for some customers.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q9_what_customers_move_to_home_braiding_by_": {
   "text": "What customers move to (home braiding by family and friends, unlicensed braiders) is of lower quality than the paid braiding it replaces.",
   "p": 0.45,
   "class": "other"
  },
  "q10_schools_licensed_cosmetologists_and_brai": {
   "text": "Schools, licensed cosmetologists and braiders can organize and spend to change or defend the requirement at a cost below their stakes.",
   "p": 0.7,
   "class": "other"
  },
  "q11_braiders_relocate_to_neighboring_states_": {
   "text": "Braiders relocate to neighboring states on a meaningful scale.",
   "p": 0.3,
   "class": "mobility"
  },
  "q12_licensed_cosmetologists_take_some_of_the": {
   "text": "Licensed cosmetologists take some of the customers who leave unlicensed braiders.",
