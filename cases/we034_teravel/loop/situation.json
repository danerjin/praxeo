 "assumptions": {
  "a1": {
   "text": "Non-competes deter some bound workers from moves to rivals or start-ups they would otherwise make.",
   "p": 0.8,
   "class": "binding"
  },
  "a2": {
   "text": "Employers stop enforcing, and workers learn that the clause is void (K4 notices, damages and fee-shifting).",
   "p": 0.8,
   "class": "enforcement"
  },
  "a5": {
   "text": "In a material share of trainee jobs, the non-compete protected the employer's recovery of the cost of general training.",
   "p": 0.7,
   "class": "other"
  },
  "a7": {
   "text": "Some bound workers are paid less than a rival would pay them.",
   "p": 0.75,
   "class": "other"
  },
  "a18": {
   "text": "The Labor Bureau's budget is not raised for the new task.",
   "p": 0.7,
   "class": "revenue_use"
  },
  "a26": {
   "text": "In the counterfactual, some Teravel employment contracts contain paid notice periods of six months or more, and some contain training repayment agreements.",
   "p": 0.7,
   "class": "other"
  },
  "a28": {
   "text": "In the counterfactual, firms that hire a bound worker from a rival bear litigation risk, demand letters or buy-out payments.",
   "p": 0.85,
   "class": "other"
  },
  "a29": {
   "text": "Some existing contracts contain forfeiture-for-competition clauses (deferred pay lost only on joining a competitor).",
   "p": 0.75,
   "class": "other"
  },
  "n1": {
   "text": "Employers and workers expect the Act to take effect on 1 January 2026 once it has passed.",
   "p": 0.9,
   "class": "expectations"
  },
  "q10_some_firms_hire_more_trained_staff_than_": {
   "text": "Some firms hire more trained staff than they train.",
   "p": 0.8,
   "class": "other"
  },
  "q11_firms_that_rely_on_hiring_experienced_st": {
   "text": "Firms that rely on hiring experienced staff, and founders, prefer to locate where staff are mobile.",
   "p": 0.6,
   "class": "other"
  },
  "q12_recruiters_handle_a_material_share_of_ex": {
   "text": "Recruiters handle a material share of experienced hires in these fields.",
   "p": 0.7,
   "class": "other"
  },
  "q13_mossgrave_bound_workers_escape_their_res": {
   "text": "Mossgrave-bound workers escape their restraints by taking Teravel jobs.",
   "p": 0.4,
   "class": "other"
  },
  "q14_employers_associations_worker_groups_and": {
   "text": "Employers' associations, worker groups and start-up associations can organize at a cost below their stake.",
   "p": 0.8,
   "class": "other"
  },
  "q15_for_many_employers_reshaping_restraints_": {
   "text": "For many employers, reshaping restraints into the preserved forms costs less than the protection it restores.",
   "p": 0.85,
   "class": "other"
  },
  "q16_employers_turn_to_trade_secret_and_non_s": {
   "text": "Employers turn to trade-secret and non-solicitation claims against departing staff.",
   "p": 0.7,
   "class": "other"
  },
  "q17_courts_accept_bona_fide_partnership_buy_": {
   "text": "Courts accept bona fide partnership buy-ins as within K2, and practices use them.",
   "p": 0.6,
   "class": "other"
  },
  "q18_token_equity_grants_made_only_to_bring_a": {
   "text": "Token equity grants, made only to bring a restraint within K2, qualify.",
   "p": 0.3,
   "class": "other"
  },
  "q19_some_employers_locate_new_training_inten": {
   "text": "Some employers locate new training-intensive work in Mossgrave because restraints are enforceable there.",
   "p": 0.55,
   "class": "other"
  },
  "q20_employers_expand_unvested_deferred_pay_a": {
   "text": "Employers expand unvested deferred pay and retention bonuses.",
   "p": 0.6,
   "class": "other"
  },
  "q21_non_competes_protected_a_material_part_o": {
   "text": "Non-competes protected a material part of net trainers' expected yield.",
   "p": 0.7,
   "class": "other"
  },
  "q22_net_trainers_cut_employer_funded_trainin": {
   "text": "Net trainers cut employer-funded training when its expected yield falls.",
   "p": 0.8,
   "class": "other"
  },
  "q23_employers_keep_writing_void_clauses_and_": {
   "text": "Employers keep writing void clauses and rely on workers not knowing.",
   "p": 0.35,
   "class": "other"
  },
  "q24_in_the_counterfactual_some_bound_workers": {
   "text": "In the counterfactual, some bound workers change employer by leaving their field.",
   "p": 0.6,
   "class": "other"
  },
  "q25_some_bound_workers_would_have_moved_to_r": {
   "text": "Some bound workers would have moved to rivals in 2025, by buy-out or litigation, and can wait.",
   "p": 0.6,
   "class": "other"
  },
  "q26_some_bound_workers_who_would_not_have_mo": {
   "text": "Some bound workers who would not have moved in 2025 in the counterfactual move late in 2025, because a suit against them would be pending on 1 January 2026 and decided under the Act.",
   "p": 0.55,
   "class": "other"
  },
  "q27_some_bound_workers_have_plans_to_start_a": {
   "text": "Some bound workers have plans to start a firm in their field that the non-compete blocks.",
   "p": 0.7,
   "class": "other"
  },
  "q28_employer_funded_training_or_trainee_hiri": {
   "text": "Employer-funded training or trainee hiring (not only trainee pay) falls enough to thin the pool of would-be founders in the bound fields within the horizon of C-3.",
   "p": 0.4,
   "class": "other"
  },
  "q29_substitute_restraints_such_as_non_solici": {
   "text": "Substitute restraints such as non-solicitation, unvested pay and retention bonuses deter some moves to rivals.",
   "p": 0.85,
   "class": "other"
  },
  "q30_substitute_restraints_non_solicitation_u": {
   "text": "Substitute restraints (non-solicitation, unvested pay, and under U2-b repayment agreements) do not fully restore that protection.",
   "p": 0.7,
   "class": "other"
  },
  "q31_a_paid_notice_period_of_six_to_twelve_mo": {
   "text": "A paid notice period of six to twelve months keeps the worker out of the field.",
   "p": 0.9,
   "class": "other"
  },
  "q32_spin_off_entry_adds_supply_that_is_not_o": {
   "text": "Spin-off entry adds supply that is not offset elsewhere (RS-13), and experienced staff pay is a material part of these services' costs (RS-14).",
   "p": 0.6,
   "class": "other"
  },
  "q33_substitute_retention_devices_deter_fewer": {
   "text": "Substitute retention devices deter fewer moves to rivals than non-competes did (dominance premise, CR-12e).",
   "p": 0.65,
   "class": "other"
  }
 }
}