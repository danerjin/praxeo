  {
   "id": "U1",
   "text": "Does K3(c) cover a paid notice period of six to twelve months in which the worker may not work for anyone else?",
   "readings": [
    "U1-a: yes, any paid notice period in which the worker remains employed is preserved",
    "U1-b: no, a notice period long enough to keep the worker out of the field is a restraint in effect and void under K1"
   ],
   "components": {
    "U1-a": [],
    "U1-b": [
     "k1b"
    ]
   }
  },
  {
   "id": "U2",
   "text": "Is a term requiring a worker who leaves within 24 months to repay employer-paid training a penalty under K1?",
   "readings": [
    "U2-a: yes, it penalizes leaving, and leaving is how one comes to work for another",
    "U2-b: no, it applies to every departure and only recovers a cost"
   ],
