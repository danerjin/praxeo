 "assumptions": {
  "a1": {
   "text": "The requirements cost some current and would-be inspectors more than they would otherwise spend.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Some incumbents who cannot be grandfathered train and sit the exam to stay in practice.",
   "class": "other",
   "p": 0.75
  },
  "a3": {
   "text": "Despite complaint-only enforcement, unlicensed practice is deterred for most inspections: agents' forms and lenders ask for the license number, and buyers and agents complain.",
   "class": "enforcement",
   "p": 0.7
  },
  "a8": {
   "text": "Exempt engineers and unlicensed practice cannot replace the excluded supply at the old fee (the response is partial).",
   "class": "other",
   "p": 0.75
  },
  "a12": {
   "text": "Some near-line inspectors would otherwise fall short of 250 inspections by their application date, and can find extra jobs.",
   "class": "other",
   "p": 0.7
  },
  "a27": {
   "text": "Some inspectors carried no insurance before.",
   "class": "other",
   "p": 0.85
  },
  "a33": {
   "text": "Inspectors' cost per inspection does not fall below its counterfactual level as the number of inspectors falls (constant or rising cost).",
   "class": "other",
   "p": 0.75
  },
  "s1": {
   "text": "Inspectors and buyers know the Act's dates and expect the license to be required on them.",
   "class": "expectations",
   "p": 0.9
  },
  "s2": {
   "text": "Incumbents expect the grandfathering window to close on 31 December 2027 and not be reopened.",
   "class": "expectations",
   "p": 0.85
  },
  "q10_agents_schools_and_the_inspectors_associ": {
   "text": "Agents, schools and the inspectors' association can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q11_some_buyers_at_the_margin_go_without_an_": {
   "text": "Some buyers at the margin go without an inspection or use an unlicensed inspector when the fee rises.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q12_some_exempt_engineers_add_home_inspectio": {
   "text": "Some exempt engineers add home inspections, and some buyers accept them.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q13_for_some_part_time_inspectors_insurance_": {
   "text": "For some part-time inspectors, insurance and the fee exceed their margin, so they stop.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q14_some_grandfathered_inspectors_would_othe": {
   "text": "Some grandfathered inspectors would otherwise leave for a year or more and return.",
   "p": 0.6,
   "class": "mobility"
  },
  "q15_engineers_supply_cannot_expand_at_unchan": {
   "text": "Engineers' supply cannot expand at unchanged cost in the period.",
   "p": 0.65,
   "class": "other"
  },
  "q16_in_the_long_run_licensed_inspectors_leav": {
   "text": "In the long run, licensed inspectors leave at a lower rate from a smaller stock than inspectors would without the Act, so replacement entry is below the counterfactual flow.",
   "p": 0.65,
   "class": "other"
  },
  "q17_inspectors_who_must_train_enroll_in_the_": {
   "text": "Inspectors who must train enroll in the first approved courses rather than wait for the 2027 deadline.",
   "p": 0.7,
   "class": "expectations"
  },
  "q18_some_grandfather_applicants_overstate_th": {
   "text": "Some grandfather applicants overstate their inspections, and the Board, checking on paper and acting otherwise only on complaint, misses it.",
   "p": 0.45,
   "class": "enforcement"
  },
  "q19_near_line_inspectors_win_the_extra_jobs_": {
   "text": "Near-line inspectors win the extra jobs mainly by cutting fees.",
   "p": 0.55,
   "class": "other"
  },
  "q20_total_inspections_in_the_window_are_set_": {
   "text": "Total inspections in the window are set by home sales, not raised by the rush.",
   "p": 0.75,
   "class": "other"
  },
  "q21_some_unlicensed_practice_continues_where": {
   "text": "Some unlicensed practice continues where complaint is least likely.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q22_most_linmouth_inspectors_serving_aldenmo": {
   "text": "Most Linmouth inspectors serving Aldenmoor do too few jobs there to cover the license's costs.",
   "p": 0.65,
   "class": "alternative_uses"
  },
  "q23_grandfathered_inspectors_stay_in_the_occ": {
   "text": "Grandfathered inspectors stay in the occupation and their volume does not fall: rivals' exit takes away more inspections than buyers drop.",
   "p": 0.65,
   "class": "other"
  }
 }
}