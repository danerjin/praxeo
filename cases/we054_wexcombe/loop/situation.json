 "assumptions": {
  "a1": {
   "text": "Without the order, daytime movements would grow above 380 a day (about 3% a year), and off-peak runway capacity allows it.",
   "class": "counterfactual_trend",
   "p": 0.85
  },
  "a2": {
   "text": "The WAA detects every movement from air traffic control's log and imposes penalties.",
   "class": "enforcement",
   "p": 0.9
  },
  "a4": {
   "text": "A slot market forms: slots are sold, leased and retimed at low transaction cost.",
   "class": "other",
   "p": 0.75
  },
  "a5": {
   "text": "Airlines expected base-season history to set their share, and some could add off-peak daytime movements at a cost below the expected value of the extra slots.",
   "class": "expectations",
   "p": 0.8
  },
  "a13": {
   "text": "The WAA sets charges to recover costs that are largely fixed.",
   "class": "other",
   "p": 0.75
  },
  "a28": {
   "text": "Night operators moved night flights into the daytime during the base seasons to earn daytime history.",
   "class": "expectations",
   "p": 0.35
  },
  "a29": {
   "text": "Some airlines not operating at WXI started there in the base seasons, at a loss on the flights below the expected value of the slots earned.",
   "class": "expectations",
   "p": 0.55
  },
  "a31": {
   "text": "Some slots will be freed under K5 (a holder ceases to operate at WXI or under-uses), so night operators' priority claim has a value.",
   "class": "other",
   "p": 0.75
  },
  "a33": {
   "text": "Penalty receipts are far smaller than the WAA's added costs: the K6 costs ($2.8 million a year) and the shortfall in charge revenue from fewer movements (about $300 more per movement by 2030 on about 140,000 movements a year).",
   "class": "other",
   "p": 0.8
  },
  "q10_some_night_operators_buy_or_lease_daytim": {
   "text": "Some night operators buy or lease daytime slots and fly in the shoulder hours.",
   "p": 0.7,
   "class": "other"
  },
  "q11_some_travelers_find_pellham_a_substitute": {
   "text": "Some travelers find Pellham a substitute.",
   "p": 0.7,
   "class": "other"
  },
  "q12_flights_at_pellham_can_be_added_in_the_p": {
   "text": "Flights at Pellham can be added in the period considered (its supply of flights is not fixed).",
   "p": 0.85,
   "class": "other"
  },
  "q13_airlines_cannot_add_flights_at_pellham_a": {
   "text": "Airlines cannot add flights at Pellham at unchanged cost, so Pellham fares rise.",
   "p": 0.35,
   "class": "other"
  },
  "q14_concession_sales_follow_passenger_number": {
   "text": "Concession sales follow passenger numbers.",
   "p": 0.8,
   "class": "other"
  },
  "q15_employment_and_hours_at_wxi_follow_movem": {
   "text": "Employment and hours at WXI follow movements and the night sort.",
   "p": 0.8,
   "class": "other"
  },
  "q16_airlines_can_move_to_larger_aircraft_on_": {
   "text": "Airlines can move to larger aircraft on some WXI routes within the medium horizon.",
   "p": 0.7,
   "class": "other"
  },
  "q17_holders_expect_slots_to_last_past_the_20": {
   "text": "Holders expect slots to last past the 2032 review without reallocation.",
   "p": 0.7,
   "class": "other"
  },
  "q18_night_operators_slot_holders_would_be_en": {
   "text": "Night operators, slot holders, would-be entrants and residents' associations can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q19_under_u1_b_airlines_move_some_flights_sc": {
   "text": "Under U1-b, airlines move some flights scheduled 22:00 to 23:00 earlier to keep a buffer against delays.",
   "p": 0.65,
   "class": "other"
  },
  "q20_buyers_of_homes_in_a_night_noise_contour": {
   "text": "Buyers of homes in a night-noise contour value quieter nights, so night movements are capitalized in home prices.",
   "p": 0.85,
   "class": "other"
  },
  "q21_without_the_order_night_operators_would_": {
   "text": "Without the order, night operators would have opposed the residents' campaign for a curfew.",
   "p": 0.75,
   "class": "other"
  },
  "q22_under_u1_a_airlines_schedule_some_flight": {
   "text": "Under U1-a, airlines schedule some flights just before 23:00 knowing they will often operate after it.",
   "p": 0.6,
   "class": "other"
  },
  "q23_the_integrator_moves_most_of_its_night_s": {
   "text": "The integrator moves most of its night sort to Pellham, and other night cargo follows.",
   "p": 0.7,
   "class": "other"
  },
  "q24_the_integrator_s_wxi_sort_facility_has_n": {
   "text": "The integrator's WXI sort facility has no equally valuable other use.",
   "p": 0.7,
   "class": "other"
  },
  "q25_with_the_sort_70_km_away_collection_cut_": {
   "text": "With the sort 70 km away, collection cut-offs in Wexcombe move earlier.",
   "p": 0.65,
   "class": "other"
  },
  "q26_restated_in_1_0_serving_wexcombe_s_regio": {
   "text": "Restated in 1.0. Serving Wexcombe's region from Pellham costs the integrator more per parcel than its WXI night sort did, net of the WXI charges and hall costs it no longer pays, so the supply of overnight delivery at the old national price is lower.",
   "p": 0.7,
   "class": "other"
  },
  "q27_larger_aircraft_and_pellham_together_can": {
   "text": "Larger aircraft and Pellham together cannot carry all of the counterfactual growth at the old cost (the responses are partial).",
   "p": 0.8,
   "class": "other"
  },
  "q28_airlines_cost_per_seat_at_wxi_does_not_f": {
   "text": "Airlines' cost per seat at WXI does not fall below its counterfactual level as movements are held below their path (constant or rising cost).",
   "p": 0.75,
   "class": "other"
  },
  "q29_airport_workers_housing_demand_is_a_mate": {
   "text": "Airport workers' housing demand is a material part of demand for homes near each airport, including the contours.",
   "p": 0.6,
   "class": "other"
  },
  "q30_employment_and_hours_at_pellham_follow_t": {
   "text": "Employment and hours at Pellham follow the movements and the night sort that move there.",
   "p": 0.75,
   "class": "other"
  },
  "q31_in_pellham_s_prospective_night_contour_t": {
   "text": "In Pellham's prospective night contour, the discount buyers place on night noise exceeds the added demand from hub workers.",
   "p": 0.6,
   "class": "other"
  },
  "q32_in_the_wxi_night_noise_contour_the_disco": {
   "text": "In the WXI night-noise contour, the discount buyers place on night noise that is removed exceeds the lost demand from fewer airport workers.",
   "p": 0.7,
   "class": "other"
  }
 }
