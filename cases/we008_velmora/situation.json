 "assumptions": {
  "a1": {"text": "The regional raw milk price stays below $21 for most of the next three years.", "class": "binding", "p": 0.8},
  "a2": {"text": "Farmers and plants expect the program to last several years.", "class": "expectations", "p": 0.65},
  "a3": {"text": "Out-of-state supply does not replace all of the withdrawn product at the old price in the short run.", "class": "substitutability", "p": 0.75},
  "a4": {"text": "Specialty plants need Velmora-origin milk to keep their label and price premium, and compete with cheesemakers who buy milk at market prices (RS-14: competitors not exposed).", "class": "other", "p": 0.7},
  "a5": {"text": "Out-of-state raw milk reaches Velmora plants at little more than transport cost.", "class": "mobility", "p": 0.85},
  "a6": {"text": "Some false certification of origin goes undetected.", "class": "enforcement", "p": 0.55},
  "a7": {"text": "Moving a dairy operation, or registering one, into Velmora is feasible for some farmers near the border.", "class": "mobility", "p": 0.6},
  "a8": {"text": "Dairy land and barns are in fixed supply in the medium run.", "class": "durability", "p": 0.85},
  "a9": {"text": "Donated stocks replace dairy that food programs would otherwise have bought.", "class": "other", "p": 0.7},
  "a10": {"text": "Velmora farmland and farm labor have other farm uses (crops, beef).", "class": "alternative_uses", "p": 0.8},
  "a11": {"text": "The program is expected to be repealed within two years.", "class": "expectations", "p": 0.3},
  "a12": {"text": "Cheddar keeps one to two years and powder two to three, and the Board disposes of stocks through K3's routes (donation, export, resale when allowed) rather than destroying them.", "class": "durability", "p": 0.8},
  "a13": {"text": "K2's support prices cover commodity plants' full costs, including a normal return on new capacity, so plants expand Board-route capacity as Velmora milk supply grows.", "class": "other", "p": 0.6},
  "a14": {"text": "Velmora dairy farmers and commodity plants can organize to lobby at a cost lower than their stake.", "class": "other", "p": 0.7}
 }
