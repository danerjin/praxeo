 "assumptions": {
  "a1": {
   "text": "Most covered chains do not now post counts on boards, and most of their buyers do not look counts up before ordering.",
   "class": "binding",
   "p": 0.8
  },
  "a3": {
   "text": "Some buyers' beliefs about calorie content differ from the posted counts.",
   "class": "other",
   "p": 0.75
  },
  "a9": {
   "text": "For some near-threshold chains, the compliance cost reverses the ranking of opening a 20th outlet.",
   "class": "other",
   "p": 0.65
  },
  "a13": {
   "text": "Many chains buy analysis from outside laboratories or consultants.",
   "class": "other",
   "p": 0.8
  },
  "a15": {
   "text": "County inspection budgets are not raised for the new task.",
   "class": "revenue_use",
   "p": 0.65
  },
  "a17": {
   "text": "Some inaccurate counts are detected and fined.",
   "class": "enforcement",
   "p": 0.55
  },
  "a24": {
   "text": "For some outlets of covered chains near closing, the one-time per-outlet board cost tips the decision to close.",
   "class": "other",
   "p": 0.4
  },
  "q8_some_buyers_who_turn_from_a_heavy_item_a": {
   "text": "Some buyers who turn from a heavy item after seeing its count go to another restaurant, including exempt ones, rather than choose another item at the same chain.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q9_buyers_who_dislike_seeing_counts_shift_t": {
   "text": "Buyers who dislike seeing counts shift to grocery prepared-food counters.",
   "p": 0.35,
   "class": "substitutability"
  },
  "q10_some_buyers_value_the_counts_enough_to_p": {
   "text": "Some buyers value the counts enough to prefer a covered chain over an exempt restaurant.",
   "p": 0.6,
   "class": "other"
  },
  "q11_for_some_small_chains_a_second_brand_cos": {
   "text": "For some small chains, a second brand costs less than compliance.",
   "p": 0.55,
   "class": "other"
  },
  "q12_chains_near_the_line_can_open_further_ou": {
   "text": "Chains near the line can open further outlets in the neighboring state, where the Act does not apply.",
   "p": 0.55,
   "class": "alternative_uses"
  },
  "q13_under_u1_b_chains_can_present_new_items_": {
   "text": "Under U1-b, chains can present new items as limited-time offers at low cost.",
   "p": 0.6,
   "class": "other"
  },
  "q14_for_some_items_a_lighter_version_costs_l": {
   "text": "For some items, a lighter version costs less than the sales it would keep.",
   "p": 0.6,
   "class": "other"
  },
  "q15_some_chains_add_new_lower_calorie_items_": {
   "text": "Some chains add new lower-calorie items, rather than only reformulating existing ones, to keep buyers who turn from heavier items.",
   "p": 0.6,
   "class": "other"
  },
  "q16_some_covered_chains_post_counts_that_dif": {
   "text": "Some covered chains post counts that differ from the actual content by more than the tolerance.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q17_chains_associations_and_independent_rest": {
   "text": "Chains' associations and independent restaurants' associations can organize at a cost below their stake.",
   "p": 0.75,
   "class": "other"
  },
  "q18_among_buyers_whose_choices_change_more_m": {
   "text": "Among buyers whose choices change, more move away from higher-calorie items than toward them.",
   "p": 0.6,
   "class": "other"
  }
 }
}