 "assumptions": {
  "a4": {
   "text": "The installments are funded mainly by higher taxes rather than lower spending.",
   "p": 0.45,
   "class": "revenue_use"
  },
  "a5": {
   "text": "Some households borrow against the expected payment before it arrives.",
   "p": 0.55,
   "class": "expectations"
  },
  "a11": {
   "text": "The bonds are repaid on the ten-year schedule rather than rolled over.",
   "p": 0.6,
   "class": "expectations"
  },
  "j1": {
   "text": "The installments are funded mainly by lower spending rather than higher taxes.",
   "p": 0.55,
   "class": "revenue_use"
  },
  "q5_the_supply_of_loans_to_kestland_is_not_p": {
   "text": "The supply of loans to Kestland is not perfectly elastic in 2027 and 2028: foreign lenders do not supply all the extra funds at the going rate.",
   "p": 0.6,
   "class": "other"
  },
  "q6_rates_on_household_deposits_and_on_card_": {
   "text": "Rates on household deposits and on card and payday credit move little in 2027 in response to the auctions; the higher rate falls mainly on business and mortgage borrowers.",
   "p": 0.6,
   "class": "other"
  },
  "q7_some_recipient_households_spend_part_of_": {
   "text": "Some recipient households spend part of the payment on present goods and services within six months, rather than saving it all or repaying debt.",
   "p": 0.9,
   "class": "other"
  },
  "q8_some_of_what_recipients_spend_on_present": {
   "text": "Some of what recipients spend on present goods buys goods that would not have been bought without the payment, rather than goods that would have been bought on credit anyway (A-6).",
   "p": 0.85,
   "class": "other"
  },
  "q9_some_recipient_households_save_part_of_t": {
   "text": "Some recipient households save part of the payment or use it to repay debt.",
   "p": 0.9,
   "class": "other"
  },
  "q10_some_recipients_would_have_borrowed_in_j": {
   "text": "Some recipients would have borrowed in July to December 2027 for purchases they now pay with the payment.",
   "p": 0.8,
   "class": "other"
  },
  "q11_recipients_spend_enough_of_the_payment_o": {
   "text": "Recipients spend enough of the payment on housing (a deposit toward a purchase, a higher rent) to raise home values.",
   "p": 0.3,
   "class": "other"
  },
  "q12_some_payments_are_diverted_by_identity_f": {
   "text": "Some payments are diverted by identity fraud, or made twice.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q13_many_households_expect_a_further_payment": {
   "text": "Many households expect a further payment and delay purchases to wait for it.",
   "p": 0.25,
   "class": "expectations"
  },
  "q14_retailers_can_organize_to_press_for_a_re": {
   "text": "Retailers can organize to press for a repeat payment, and expect a chance of success.",
   "p": 0.45,
   "class": "other"
  },
  "q15_households_apply_for_the_payment_only_if": {
   "text": "Households apply for the payment only if it is worth more to them than the cost of applying.",
   "p": 0.95,
   "class": "other"
  },
  "q16_for_some_households_forming_a_separate_q": {
   "text": "For some households, forming a separate qualifying household costs less than a second payment.",
   "p": 0.7,
   "class": "other"
  },
  "q17_many_households_expect_to_bear_part_of_t": {
   "text": "Many households expect to bear part of the later installments.",
   "p": 0.6,
   "class": "expectations"
  },
  "q18_most_private_borrowing_at_the_margin_fin": {
   "text": "Most private borrowing at the margin finances business investment and home purchases.",
   "p": 0.75,
   "class": "other"
  },
  "q19_the_tax_agency_detects_some_false_or_dup": {
   "text": "The Tax Agency detects some false or duplicate claims and recovers repayments and fines.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q20_money_that_recipients_save_or_use_to_rep": {
   "text": "Money that recipients save or use to repay debt returns to the pool of loanable funds.",
   "p": 0.85,
   "class": "other"
  },
  "q21_investment_crowded_out_in_2027_and_2028_": {
   "text": "Investment crowded out in 2027 and 2028 is not fully made up in later years.",
   "p": 0.6,
   "class": "durability"
  },
  "q22_the_supply_of_homes_is_slow_to_respond_i": {
   "text": "The supply of homes is slow to respond in 2027 and 2028.",
   "p": 0.85,
   "class": "alternative_uses"
  },
  "q23_the_fall_in_mortgage_borrowing_outweighs": {
   "text": "The fall in mortgage borrowing outweighs housing spending out of the payment in the market for homes.",
   "p": 0.7,
   "class": "other"
  },
  "q24_sellers_adjust_staff_or_hours_to_sales_w": {
   "text": "Sellers adjust staff or hours to sales within months.",
   "p": 0.8,
   "class": "alternative_uses"
  }
 }
}