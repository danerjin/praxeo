 "assumptions": {
  "a1": {
   "text": "Market rents keep rising faster than 1.8% a year, so the cap binds within the first year and the gap grows.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "The board enforces the cap against most landlords.",
   "class": "enforcement",
   "p": 0.8
  },
  "a3": {
   "text": "Covered tenancies cannot be assigned or sold, and sublets are limited to the tenant's rent.",
   "class": "other",
   "p": 0.9
  },
  "a4": {
   "text": "Enough leases renew in the window, and landlords raise rents at renewal to lift the base.",
   "class": "expectations",
   "p": 0.75
  },
  "a5": {
   "text": "Without the ordinance, sitting tenants' rents would follow the market within one or two lease cycles, so the counterfactual passes any pre-emptive raise within the medium horizon.",
   "class": "other",
   "p": 0.7
  },
  "a7": {
   "text": "For some qualifying seniors who would have left Ambry County, the credit is worth more than what they would have gained by leaving, so they choose a county option instead.",
   "class": "mobility",
   "p": 0.7
  },
  "a9": {
   "text": "Some qualifying and near-qualifying seniors know the credit's conditions and delay moves to meet them.",
   "class": "expectations",
   "p": 0.6
  },
  "a12": {
   "text": "The withdrawal route is used for a meaningful number of buildings.",
   "class": "alternative_uses",
   "p": 0.75
  },
  "a16": {
   "text": "Some qualifying seniors leave covered units for rentals in Ambry County and claim the credit.",
   "class": "other",
   "p": 0.9
  },
  "a17": {
   "text": "The rise in county rents caused by the policy is far smaller than the credit for those who hold it.",
   "class": "other",
   "p": 0.9
  },
  "a36": {
   "text": "By the long horizon some credit holders' credit is at or above the rent of the home they rent (core re-run A-N5).",
   "class": "other",
   "p": 0.55
  },
  "j1": {
   "text": "The rent board enforces the five-year bar on re-letting withdrawn units.",
   "class": "enforcement",
   "p": 0.8
  },
  "j2": {
   "text": "The county court enforces the for-cause rule against landlords.",
   "class": "enforcement",
   "p": 0.85
  },
  "j3": {
   "text": "The credit and the county's administration fee are paid from the City's general fund.",
   "class": "revenue_use",
   "p": 0.95
  },
  "q15_the_credit_is_paid_out_of_other_uses_of_": {
   "text": "The credit is paid out of other uses of the general fund, since no tax is named for it.",
   "p": 0.65,
   "class": "revenue_use"
  },
  "q16_in_a_building_an_owner_plans_to_withdraw": {
   "text": "In a building an owner plans to withdraw, holding a vacated unit empty pays better than re-letting it, for some owners (core re-run A-N7).",
   "p": 0.6,
   "class": "alternative_uses"
  },
  "q17_some_landlords_pay_sitting_tenants_to_va": {
   "text": "Some landlords pay sitting tenants to vacate, and some tenants accept (core re-run A-N2).",
   "p": 0.6,
   "class": "other"
  },
  "q18_the_housing_code_leaves_room_to_cut_main": {
   "text": "The housing code leaves room to cut maintenance above the legal minimum.",
   "p": 0.85,
   "class": "other"
  },
  "q19_rental_buildings_last_several_decades_so": {
   "text": "Rental buildings last several decades, so the stock changes slowly.",
   "p": 0.95,
   "class": "alternative_uses"
  },
  "q20_some_landlords_end_month_to_month_tenanc": {
   "text": "Some landlords end month-to-month tenancies without cause in the window, to re-let at the market before the base date or to hold units empty for withdrawal.",
   "p": 0.7,
   "class": "expectations"
  },
  "q21_landlords_tenant_unions_and_senior_advoc": {
   "text": "Landlords, tenant unions and senior advocates can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q22_rent_regulation_would_have_been_conteste": {
   "text": "Rent regulation would have been contested on the counterfactual path.",
   "p": 0.85,
   "class": "other"
  },
  "q23_buyers_of_buildings_expect_the_ordinance": {
   "text": "Buyers of buildings expect the ordinance to last many years.",
   "p": 0.75,
   "class": "expectations"
  },
  "q24_because_of_the_policy_free_rents_in_tess": {
   "text": "Because of the policy, free rents in Tessford (exempt units, initial rents of new covered tenancies) rise more than rents elsewhere in Ambry County, for the homes movers choose (core re-run A-N1, widened from seniors to all movers).",
   "p": 0.6,
   "class": "other"
  },
  "q25_owners_sell_withdrawn_units_as_condomini": {
   "text": "Owners sell withdrawn units as condominiums.",
   "p": 0.85,
   "class": "alternative_uses"
  },
  "q26_some_displaced_households_next_best_home": {
   "text": "Some displaced households' next-best home is outside Tessford, and some outside Ambry County.",
   "p": 0.85,
   "class": "mobility"
  },
  "q27_more_than_about_115_households_shut_out_": {
   "text": "More than about 115 households shut out of Tessford settle elsewhere in Ambry County each year, and county rental supply cannot expand at an unchanged cost in the medium horizon.",
   "p": 0.7,
   "class": "other"
  },
  "q28_without_the_ordinance_some_sitting_tenan": {
   "text": "Without the ordinance, some sitting tenants would have left Tessford (and some seniors Ambry County), priced out or for opportunities elsewhere.",
   "p": 0.95,
   "class": "mobility"
  },
  "q29_some_job_opportunities_for_sitting_tenan": {
   "text": "Some job opportunities for sitting tenants would require leaving the unit.",
   "p": 0.75,
   "class": "mobility"
  },
  "q30_each_covered_unit_a_sitting_tenant_does_": {
   "text": "Each covered unit a sitting tenant does not leave is one fewer vacancy offered to new tenants.",
   "p": 0.95,
   "class": "other"
  },
  "q31_some_seekers_shut_out_of_tessford_settle": {
   "text": "Some seekers shut out of Tessford settle elsewhere in the county and in Durnside and commute.",
   "p": 0.8,
   "class": "mobility"
  },
  "q32_more_than_about_35_households_shut_out_o": {
   "text": "More than about 35 households shut out of Tessford settle in Durnside each year, and Durnside's supply cannot expand at once.",
   "p": 0.7,
   "class": "mobility"
  },
  "q33_covered_and_exempt_tessford_units_are_cl": {
   "text": "Covered and exempt Tessford units are close substitutes.",
   "p": 0.85,
   "class": "substitutability"
  },
  "q34_owners_and_developers_expect_the_exempti": {
   "text": "Owners and developers expect the exemption of post-1989 buildings to last.",
   "p": 0.6,
   "class": "expectations"
  },
  "q35_some_qualifying_seniors_who_would_have_m": {
   "text": "Some qualifying seniors who would have moved in with family or bought a home in the county rent instead, to keep the credit (core re-run A-N6).",
   "p": 0.55,
   "class": "substitutability"
  },
  "q36_some_sublets_above_the_controlled_rent_g": {
   "text": "Some sublets above the controlled rent go undetected.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q37_fewer_than_about_58_of_buyers_of_withdra": {
   "text": "Fewer than about 58% of buyers of withdrawn units vacate a Tessford rental to buy, so each withdrawal adds to excess demand for Tessford rentals (core re-run A-N8).",
   "p": 0.6,
   "class": "other"
  },
  "q38_any_rise_in_covered_vacancies_from_quali": {
   "text": "Any rise in covered vacancies from qualifying seniors' turnover is smaller than the fall in vacancies from keepers and withdrawals (core re-run A-N9).",
   "p": 0.8,
   "class": "other"
  },
  "q39_in_the_medium_horizon_what_covered_landl": {
   "text": "In the medium horizon, what covered landlords gain from higher initial rents on new tenancies is smaller than what they lose on tenancies in place, in fees, relocation payments and buyouts (new).",
   "p": 0.8,
   "class": "other"
  },
  "q40_savings_built_from_the_capped_rent_can_p": {
   "text": "Savings built from the capped rent can pay for a move that the cap itself makes less attractive.",
   "p": 0.75,
   "class": "other"
  },
  "q41_for_insiders_who_keep_their_units_the_fo": {
   "text": "For insiders who keep their units, the forfeit of the future gap outweighs any move that savings built from the gap make affordable (CR-4 exception).",
   "p": 0.8,
   "class": "other"
  },
  "q42_buyouts_move_fewer_keepers_out_of_their_": {
   "text": "Buyouts move fewer keepers out of their units than the cap and the for-cause rule hold in place (core re-run A-N3; PC-7 1.4 and PC-21 1.4, Assumes).",
   "p": 0.7,
   "class": "other"
  },
  "q43_for_non_qualifying_keepers_the_lock_in_f": {
   "text": "For non-qualifying keepers, the lock-in from forfeiting the gap outweighs any diversion of their remaining moves out of Tessford, or out of Ambry County, by the policy's rise in Tessford's free rents relative to destinations (new; the dominance premise PC-21 1.4 asks for).",
   "p": 0.75,
   "class": "other"
  },
  "q44_some_displaced_households_rent_another_h": {
   "text": "Some displaced households rent another home in Tessford.",
   "p": 0.9,
   "class": "mobility"
  },
  "q45_by_the_third_year_the_cap_cuts_non_quali": {
   "text": "By the third year, the cap cuts non-qualifying keepers' moves out of Tessford by more than 5% of the counterfactual (about 170 a year), more than the displaced non-senior households who leave the city (at most about 145 a year).",
   "p": 0.7,
   "class": "other"
  }
 }
}