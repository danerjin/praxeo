 "assumptions": {
  "a1": {
   "text": "Imports remain a meaningful share of supply, and foreign sellers do not absorb most of the tariff.",
   "class": "binding",
   "p": 0.85
  },
  "a2": {
   "text": "Domestic mills can raise output from spare or idle capacity and produce close substitutes for most imports.",
   "class": "substitutability",
   "p": 0.75
  },
  "a3": {
   "text": "Some imports can be reshaped to fall outside the tariff's definitions at a cost below 25%.",
   "class": "other",
   "p": 0.7
  },
  "a5": {
   "text": "Exclusions are decided case by case, with weight given to objections from the mills.",
   "class": "other",
   "p": 0.7
  },
  "a6": {
   "text": "Steelmakers and users organize to influence renewal and exclusions.",
   "class": "other",
   "p": 0.85
  },
  "a7": {
   "text": "Many steel users compete with imported finished goods that are not taxed.",
   "class": "substitutability",
   "p": 0.8
  },
  "a8": {
   "text": "The fall in steel imports is not offset by capital flows or other adjustments within the medium horizon.",
   "class": "other",
   "p": 0.6
  },
  "a9": {
   "text": "Some steel-using firms have the option of producing abroad when plants are replaced.",
   "class": "mobility",
   "p": 0.6
  },
  "a10": {
   "text": "Steelmakers expect the tariff to be renewed at the year-three review.",
   "class": "expectations",
   "p": 0.55
  },
  "a11": {
   "text": "Investors expect the tariff to stay in force for at least its three-year term.",
   "class": "expectations",
   "p": 0.8
  },
  "a14": {
   "text": "Steel is a material part of construction costs and builders cannot replace it at the old cost in the medium run.",
   "class": "substitutability",
   "p": 0.8
  },
  "a15": {
   "text": "Halvern's machinery exporters sell at prices set in world markets.",
   "class": "substitutability",
   "p": 0.8
  },
  "a16": {
   "text": "The budgets of customs and the exclusion office are raised to cover the new work.",
   "class": "revenue_use",
   "p": 0.65
  },
  "a4": {
   "text": "Users and importers can store steel and order ahead.",
   "class": "expectations",
   "p": 0.8
  }
 },
