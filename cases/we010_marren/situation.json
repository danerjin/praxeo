 "assumptions": {
  "a1": {
   "text": "Most of the increase is passed on in Marren shelf prices.",
   "class": "other",
   "p": 0.85
  },
  "a2": {
   "text": "Some smokers cut back or switch at the higher price.",
   "class": "substitutability",
   "p": 0.85
  },
  "a3": {
   "text": "Many Marren smokers can easily buy in Dunmarch or Kessick.",
   "class": "mobility",
   "p": 0.85
  },
  "a4": {
   "text": "Enforcement against casual resale and carrying above the allowance is weak, and the use tax is rarely collected.",
   "class": "enforcement",
   "p": 0.8
  },
  "a5": {
   "text": "Smuggling networks expect the price gap to last for years.",
   "class": "expectations",
   "p": 0.65
  },
  "a6": {
   "text": "Untaxed or lower-taxed products are acceptable substitutes for some smokers.",
   "class": "substitutability",
   "p": 0.75
  },
  "a7": {
   "text": "Producers can make cigarette-like products that meet the \"other tobacco\" definition.",
   "class": "other",
   "p": 0.7
  },
  "a8": {
   "text": "Border retailers, health groups and producers organize to change the rules.",
   "class": "other",
   "p": 0.7
  },
  "a9": {
   "text": "Smokers know the date and can store cartons.",
   "class": "expectations",
   "p": 0.8
  },
  "a10": {
   "text": "Cross-border cigarette buyers also buy fuel, snacks and other goods on the same trip.",
   "class": "other",
   "p": 0.75
  },
  "a11": {
   "text": "The cost of a trip is large relative to the saving on one pack but small relative to the saving on a carton.",
   "class": "other",
   "p": 0.8
  },
  "a12": {
   "text": "Smuggling networks corrupt enforcement officers on a meaningful scale.",
   "class": "enforcement",
   "p": 0.25
  },
  "a13": {
   "text": "Dunmarch or Kessick limit sales to Marren residents.",
   "class": "other",
   "p": 0.2
  },
  "a14": {
   "text": "Marren border retailers move across the line within five years.",
   "class": "mobility",
   "p": 0.35
  },
  "a15": {
   "text": "The quit program was already funded from general revenue, and the act has no maintenance-of-effort clause.",
   "class": "revenue_use",
   "p": 0.6
  },
  "a16": {
   "text": "Stamped cigarette sales in Marren fall by less than half, compared with the counterfactual, in the short and medium run.",
   "class": "substitutability",
   "p": 0.8
  },
  "a17": {
   "text": "Retail sites near the crossings are in fixed supply in the medium run (zoning, the few sites on the approaches to the bridges).",
   "class": "durability",
   "p": 0.7
  }
 }
}