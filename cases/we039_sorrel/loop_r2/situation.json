 "assumptions": {
  "a1": {
   "text": "Without the cap, pumping would stay near 300,000 af and above 210,000.",
   "class": "binding",
   "p": 0.95
  },
  "a2": {
   "text": "The cap is enforced against most pumpers: meters, telemetry and satellite checks detect most over-pumping.",
   "class": "enforcement",
   "p": 0.75
  },
  "a10": {
   "text": "Detection is weak for some wells, so some pumpers over-pump.",
   "class": "enforcement",
   "p": 0.55
  },
  "a12": {
   "text": "Land buyers priced the expected claim to shares from the publication of the draft plan.",
   "class": "expectations",
   "p": 0.75
  },
  "a17": {
   "text": "Some pumpers inflated 2017 to 2021 pumping in anticipation of allocation by history.",
   "class": "expectations",
   "p": 0.2
  },
  "a4": {
   "text": "A lease market forms: transaction costs are low enough for holders to lease to others within a season.",
   "class": "other",
   "p": 0.8
  },
  "q7_some_basin_farms_can_buy_regional_surfac": {
   "text": "Some basin farms can buy regional surface water, whose supply is fixed by allotments in a given year.",
   "p": 0.65,
   "class": "other"
  },
  "q8_some_nut_growers_in_south_and_elsewhere_": {
   "text": "Some nut growers, in South and elsewhere, value the last af they would have pumped without the cap below the lease price, so they give it up rather than lease it (the leasing response is partial).",
   "p": 0.8,
   "class": "other"
  },
  "q9_some_basin_growers_can_farm_in_the_lowth": {
   "text": "Some basin growers can farm in the Lowther Basin, which has no cap until its plan.",
   "p": 0.55,
   "class": "other"
  },
  "q10_some_non_domestic_wells_are_backups_or_l": {
   "text": "Some non-domestic wells are backups or low-use wells that owners retire rather than meter.",
   "p": 0.6,
   "class": "other"
  },
  "q11_basin_growers_take_national_crop_prices_": {
   "text": "Basin growers take national crop prices as given.",
   "p": 0.85,
   "class": "other"
  },
  "q12_under_the_cap_the_water_table_falls_more": {
   "text": "Under the cap, the water table falls more slowly than it would have.",
   "p": 0.85,
   "class": "other"
  },
  "q13_the_lease_price_of_an_af_far_exceeds_the": {
   "text": "The lease price of an af far exceeds the energy it saves through a slower-falling table over the medium horizon.",
   "p": 0.9,
   "class": "other"
  },
  "q14_farm_employment_and_hours_adjust_to_acre": {
   "text": "Farm employment and hours adjust to acres farmed.",
   "p": 0.75,
   "class": "other"
  },
  "q15_input_suppliers_sell_mainly_to_basin_far": {
   "text": "Input suppliers sell mainly to basin farms.",
   "p": 0.6,
   "class": "other"
  },
  "q16_the_fall_in_basin_tree_nut_output_moves_": {
   "text": "The fall in basin tree-nut output moves national tree-nut prices by more than a negligible amount.",
   "p": 0.3,
   "class": "other"
  },
  "q17_south_growers_north_communities_and_land": {
   "text": "South growers, North communities and landholders without history can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q18_under_u1_b_south_growers_could_lease_in_": {
   "text": "Under U1-b, South growers could lease in enough North and Central allocations to approach South's counterfactual pumping.",
   "p": 0.5,
   "class": "other"
  },
  "q19_some_field_crop_growers_value_lease_inco": {
   "text": "Some field-crop growers value lease income above farming their allocation.",
   "p": 0.75,
   "class": "other"
  },
  "q20_some_holders_lease_out_or_sell_their_who": {
   "text": "Some holders lease out or sell their whole allocation and stop irrigating.",
   "p": 0.7,
   "class": "other"
  },
  "q21_the_value_of_the_free_shares_to_history_": {
   "text": "The value of the free shares to history holders exceeds the fees they pay on them.",
   "p": 0.95,
   "class": "other"
  },
  "q22_holders_expect_shares_to_last_without_ea": {
   "text": "Holders expect shares to last, without early reallocation.",
   "p": 0.75,
   "class": "other"
  },
  "q23_the_lottery_s_expected_value_per_entry_e": {
   "text": "The lottery's expected value per entry exceeds the cost of entering for many eligible parcels.",
   "p": 0.85,
   "class": "other"
  },
  "q24_parcels_can_be_split_or_transferred_into": {
   "text": "Parcels can be split or transferred into separate ownership before 1 July 2027 (lot-line adjustments approved within months).",
   "p": 0.6,
   "class": "other"
  },
  "q25_landholders_planning_new_orchards_gave_w": {
   "text": "Landholders planning new orchards gave weight to the draft plan from 2022.",
   "p": 0.7,
   "class": "other"
  },
  "q26_the_fall_in_basin_field_crop_output_move": {
   "text": "The fall in basin field-crop output moves national field-crop prices by more than a negligible amount.",
   "p": 0.15,
   "class": "other"
  }
 }
