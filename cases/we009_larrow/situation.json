 "assumptions": {
  "a1": {
   "text": "For an identifiable group of adults, employers value their labor below the new floor.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Some workers under 20 would earn less than the youth rate.",
   "class": "binding",
   "p": 0.8
  },
  "a3": {
   "text": "Most employers comply with the floor.",
   "class": "enforcement",
   "p": 0.75
  },
  "a4": {
   "text": "Employers can adjust at least one margin: hiring, hours, schedules, breaks, training or benefits.",
   "class": "other",
   "p": 0.9
  },
  "a5": {
   "text": "Recasting some workers as independent contractors is feasible.",
   "class": "other",
   "p": 0.55
  },
  "a6": {
   "text": "Some cash payment below the floor goes undetected.",
   "class": "enforcement",
   "p": 0.65
  },
  "a7": {
   "text": "Labor-saving equipment exists for some low-wage tasks.",
   "class": "alternative_uses",
   "p": 0.75
  },
  "a8": {
   "text": "Employers planning outlets expected both steps to take effect.",
   "class": "expectations",
   "p": 0.85
  },
  "a10": {
   "text": "Most sellers of low-wage-intensive services compete mainly with Larrow sellers who face the same floor.",
   "class": "other",
   "p": 0.8
  },
  "a11": {
   "text": "Larrow Falls residents can easily shop and eat in Port Dorran.",
   "class": "mobility",
   "p": 0.7
  },
  "a12": {
   "text": "A meaningful number of employers use the youth rate.",
   "class": "other",
   "p": 0.8
  },
  "a13": {
   "text": "Workers under 20 and adults are substitutes in many low-wage jobs.",
   "class": "substitutability",
   "p": 0.8
  },
  "a14": {
   "text": "The floor raises employers' labor cost per hour for the bound group; it is not fully offset.",
   "class": "substitutability",
   "p": 0.8
  },
  "a15": {
   "text": "Employers' associations and unions can organize to lobby at a cost lower than their stake.",
   "class": "other",
   "p": 0.65
  },
  "a16": {
   "text": "The Labor Department's investigator staff and budget are not increased for the Act.",
   "class": "revenue_use",
   "p": 0.6
  }
 }
}