 "assumptions": {
  "a1": {
   "text": "Market rents keep rising above 2% a year, so the cap binds within the first year.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "The rent board enforces the cap against most landlords.",
   "class": "enforcement",
   "p": 0.8
  },
  "a3": {
   "text": "Some landlords and tenants evade (key money, illegal sublets) without being caught.",
   "class": "enforcement",
   "p": 0.8
  },
  "a4": {
   "text": "Housing codes leave landlords room to reduce maintenance above the legal minimum.",
   "class": "other",
   "p": 0.85
  },
  "a5": {
   "text": "The conversion route is usable for a meaningful number of buildings.",
   "class": "alternative_uses",
   "p": 0.7
  },
  "a6": {
   "text": "Sitting tenants cannot transfer their tenancy.",
   "class": "other",
   "p": 0.95
  },
  "a7": {
   "text": "Covered and exempt units are close substitutes.",
   "class": "substitutability",
   "p": 0.85
  },
  "a8": {
   "text": "Commuting from neighboring cities is practical for many seekers.",
   "class": "mobility",
   "p": 0.7
  },
  "a9": {
   "text": "Developers expect the new-construction exemption to last.",
   "class": "expectations",
   "p": 0.6
  },
  "a10": {
   "text": "Rental buildings last several decades, so supply adjusts slowly.",
   "class": "durability",
   "p": 0.95
  },
  "a12": {
   "text": "Some job opportunities for sitting tenants would require moving or a much longer commute.",
   "class": "mobility",
   "p": 0.75
  },
  "a13": {
   "text": "Buyers of buildings expect the ordinance to last for many years.",
   "class": "expectations",
   "p": 0.75
  },
  "a14": {
   "text": "Without the ordinance, sitting tenants' rents would follow the market path within one or two lease cycles.",
   "class": "other",
   "p": 0.7
  },
  "a15": {
   "text": "There is no public waiting list for covered units, so seekers find vacancies by their own search.",
   "class": "other",
   "p": 0.9
  },
  "a16": {
   "text": "Landlords may choose among applicants, and fair-housing law leaves room to screen.",
   "class": "other",
   "p": 0.85
  },
  "a17": {
   "text": "Some sitting tenants would, at market rents, have moved to smaller units or taken in roommates.",
   "class": "substitutability",
   "p": 0.8
  },
  "a18": {
   "text": "Landlords, tenant groups and developers can organize and spend at a cost below their stakes.",
   "class": "other",
   "p": 0.8
  },
  "a19": {
   "text": "The rent board is a new appropriation that raises the general budget.",
   "class": "revenue_use",
   "p": 0.75
  }
 }
}