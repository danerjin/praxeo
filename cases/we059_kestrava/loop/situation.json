 "unclear": [
  {
   "id": "U1",
   "text": "Parts pairing: does section 5(c) forbid pairing that needs the maker's authorization, or only locks the owner cannot unlock with a tool the maker supplies?",
   "readings": [
    "U1-a: pairing that needs the maker's authorization is itself the lock section 5(c) forbids; any part must work fully without contacting the maker, and makers must remove pairing from covered devices",
    "U1-b: a lock is lawful if the owner or a repairer acting for the owner can pair a genuine part with a tool the maker supplies on fair and reasonable terms; makers may refuse to pair stolen or non-genuine parts"
   ],
   "components": {
    "U1-a": [
     "k3_a"
    ],
    "U1-b": [
     "k3_b"
    ]
   }
  }
 ],
