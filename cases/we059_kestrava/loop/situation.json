 "dominance": [],
 "assumptions": {
  "a1": {
   "text": "Most makers comply with K1 in most cases.",
   "class": "enforcement",
   "p": 0.7
  },
  "a2": {
   "text": "Before the Act, makers did not offer independents and owners genuine parts, tools and software on the terms they gave authorized repairers (except one phone maker's national program, which matches on price and meets U1-b), and anti-repair terms were in use.",
   "class": "binding",
   "p": 0.9
  },
  "a6": {
   "text": "Makers bear costs from K1 and K2 (margin on repair inputs, supply and support) and seek to recover them through other terms of sale.",
   "class": "other",
   "p": 0.85
  },
  "a18": {
   "text": "Farm equipment makers raise list prices in Kestrava relative to Darnholt.",
   "class": "other",
   "p": 0.55
  },
  "a25": {
   "text": "For each maker, the lost margin on repair inputs, the voided terms and the costs of compliance outweigh any gain from every rival being bound at once and from buyers' higher valuation of covered units.",
   "class": "other",
   "p": 0.7
  },
  "j_ann": {
   "text": "Makers and dealers expected the Act to take effect on 1 September 2028 once it was signed on 1 March 2027.",
   "class": "expectations",
   "p": 0.9
  },
  "j_nat": {
   "text": "Phone makers keep their prices the same in every state during the period.",
   "class": "other",
   "p": 0.7
  },
  "j_k2": {
   "text": "Makers and dealers stop using terms that restrict repair once such terms are void.",
   "class": "enforcement",
   "p": 0.8
  },
  "j_k3": {
   "text": "Where pairing needs the maker's authorization, makers remove that need once pairing is forbidden.",
   "class": "enforcement",
   "p": 0.8
  },
  "j_bud": {
   "text": "The Consumer Protection Division handles fewer of its other complaints when repair complaints take its time.",
   "class": "revenue_use",
   "p": 0.7
  },
  "q11_makers_dealers_farm_groups_and_repair_as": {
   "text": "Makers, dealers, farm groups and repair associations can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q12_dealers_capital_and_locations_are_tied_t": {
   "text": "Dealers' capital and locations are tied to their territory, while makers sell in many states at national prices.",
   "p": 0.75,
   "class": "mobility"
  },
  "q13_makers_dealers_and_investors_expect_the_": {
   "text": "Makers, dealers and investors expect the Act to stay in force.",
   "p": 0.8,
   "class": "mobility"
  },
  "q14_dealers_and_authorized_providers_repair_": {
   "text": "Dealers' and authorized providers' repair capacity cannot contract at once.",
   "p": 0.75,
   "class": "durability"
  },
  "q15_some_compact_tractors_can_be_designed_an": {
   "text": "Some compact tractors can be designed and marketed for grounds care at a cost below the burden of coverage.",
   "p": 0.55,
   "class": "other"
  },
  "q16_some_makers_respond_by_integrating_compo": {
   "text": "Some makers respond by integrating components or (under U1-b) by pairing more parts, to keep control of which parts work.",
   "p": 0.55,
