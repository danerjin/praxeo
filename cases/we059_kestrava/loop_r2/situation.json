 "assumptions": {
  "a1": {
   "text": "Most makers comply with K1 in most cases.",
   "p": 0.7,
   "class": "enforcement"
  },
  "a2": {
   "text": "Before the Act, makers did not offer independents and owners genuine parts, tools and software on the terms they gave authorized repairers (except one phone maker's national program, which matches on price and meets U1-b), and anti-repair terms were in use.",
   "p": 0.9,
   "class": "binding"
  },
  "a6": {
   "text": "Makers bear costs from K1 and K2 (margin on repair inputs, supply and support) and seek to recover them through other terms of sale.",
   "p": 0.85,
   "class": "other"
  },
  "a18": {
   "text": "Farm equipment makers raise list prices in Kestrava relative to Darnholt.",
   "p": 0.55,
   "class": "other"
  },
  "a20": {
   "text": "Makers, dealers and investors expect the Act to stay in force.",
   "p": 0.8,
   "class": "expectations"
  },
  "a25": {
   "text": "For each maker, the lost margin on repair inputs, the voided terms and the costs of compliance outweigh any gain from every rival being bound at once and from buyers' higher valuation of covered units.",
   "p": 0.7,
   "class": "other"
  },
  "j1": {
   "text": "A void term cannot be enforced against an owner who repairs elsewhere.",
   "p": 0.9,
   "class": "enforcement"
  },
  "j2": {
   "text": "Makers of recent phone models pair screens, batteries and cameras to the device through the maker's server.",
   "p": 0.95,
   "class": "binding"
  },
  "j3": {
   "text": "Many electronic parts of farm equipment cannot be calibrated or paired without the maker's diagnostic software.",
   "p": 0.95,
   "class": "binding"
  },
  "j4": {
   "text": "The Consumer Protection Division's budget is unchanged by the Act.",
   "p": 0.95,
   "class": "revenue_use"
  },
  "q11_some_owners_prefer_independent_or_self_r": {
   "text": "Some owners prefer independent or self repair at the new terms.",
   "p": 0.9,
   "class": "substitutability"
  },
  "q12_some_repairs_can_be_deferred_for_months": {
   "text": "Some repairs can be deferred for months.",
   "p": 0.6,
   "class": "other"
  },
  "q13_owners_could_not_read_fault_codes_or_doc": {
   "text": "Owners could not read fault codes or documentation before, and some use them to diagnose or to shop for repairs.",
   "p": 0.85,
   "class": "other"
  },
  "q14_growers_can_keep_uncovered_tractors_in_s": {
   "text": "Growers can keep uncovered tractors in service longer in place of buying covered ones.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q15_makers_dealers_farm_groups_and_repair_as": {
   "text": "Makers, dealers, farm groups and repair associations can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q16_some_compact_tractors_can_be_designed_an": {
   "text": "Some compact tractors can be designed and marketed for grounds care at a cost below the burden of coverage.",
   "p": 0.55,
   "class": "other"
  },
  "q17_the_attorney_general_acts_only_on_compla": {
   "text": "The Attorney General acts only on complaint, and some makers' offers fall short.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q18_for_some_specialty_farm_models_with_fewe": {
   "text": "For some specialty farm models with fewer than 20 sales a year in Kestrava, the cost of supplying documentation, tools and software for the model there exceeds the margin on those sales.",
   "p": 0.5,
   "class": "other"
  },
  "q19_some_makers_respond_by_integrating_compo": {
   "text": "Some makers respond by integrating components or (under U1-b) by pairing more parts, to keep control of which parts work.",
   "p": 0.55,
   "class": "other"
  },
  "q20_investors_value_makers_expected_repair_i": {
   "text": "Investors value makers' expected repair-input margins in Kestrava.",
   "p": 0.85,
   "class": "expectations"
  },
  "q21_pairing_and_activation_locks_now_keep_mo": {
   "text": "Pairing and activation locks now keep most parts of reported stolen phones from working in other devices; under U1-a they would work.",
   "p": 0.65,
   "class": "other"
  },
  "q22_phone_makers_extend_their_parts_and_tool": {
   "text": "Phone makers extend their parts and tool programs to owners in all states rather than only Kestrava.",
   "p": 0.6,
   "class": "other"
  },
  "q23_more_repairers_and_self_repair_shorten_w": {
   "text": "More repairers and self-repair shorten waits at harvest.",
   "p": 0.75,
   "class": "other"
  },
  "q24_dealers_and_authorized_providers_repair_": {
   "text": "Dealers' and authorized providers' repair capacity cannot contract at once.",
   "p": 0.75,
   "class": "durability"
  },
  "q25_owners_shift_to_independent_and_self_rep": {
   "text": "Owners' shift to independent and self repair outweighs the extra repair of older equipment kept in service.",
   "p": 0.65,
   "class": "other"
  },
  "q26_independent_shops_can_open_or_expand_onc": {
   "text": "Independent shops can open or expand once inputs are available.",
   "p": 0.75,
   "class": "mobility"
  },
  "q27_in_the_long_run_independent_repair_capac": {
   "text": "In the long run independent repair capacity can be added at roughly constant cost.",
   "p": 0.6,
   "class": "other"
  },
  "q28_dealers_capital_and_locations_are_tied_t": {
   "text": "Dealers' capital and locations are tied to their territory, while makers sell in many states at national prices.",
   "p": 0.75,
   "class": "mobility"
  },
  "q29_independents_gain_from_access_to_parts_t": {
   "text": "Independents' gain from access to parts, tools and software outweighs the loss from makers integrating components.",
   "p": 0.7,
   "class": "other"
  },
  "q30_some_buyers_of_used_phones_check_the_par": {
   "text": "Some buyers of used phones check the part notices and pay less for phones with unpaired parts.",
   "p": 0.6,
   "class": "other"
  }
 }
