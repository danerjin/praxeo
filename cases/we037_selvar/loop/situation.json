 "assumptions": {
  "a1": {
   "text": "For high-demand events, the market resale price is above face value plus 10%, so K1 binds.",
   "p": 0.95,
   "class": "binding"
  },
  "a2": {
   "text": "Compliant platforms, which carry 77% of resale by value, enforce the cap on their listings.",
   "p": 0.85,
   "class": "enforcement"
  },
  "a8": {
   "text": "Holders and buyers know from February 2027 that resales from 1 September will be capped, and can time their sales and purchases.",
   "p": 0.7,
   "class": "expectations"
  },
  "a11": {
   "text": "Buyers sue in meaningful numbers to recover three times the excess.",
   "p": 0.45,
   "class": "enforcement"
  },
  "a13": {
   "text": "K2 is enforced enough to cut bot purchases beyond what R1 already did.",
   "p": 0.45,
   "class": "enforcement"
  },
  "a21": {
   "text": "The division's budget does not rise with the new work.",
   "p": 0.8,
   "class": "revenue_use"
  },
  "j1": {
   "text": "The Attorney General's division brings penalty actions against some above-cap resales.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q8_brokers_platforms_fan_groups_and_primary": {
   "text": "Brokers, platforms, fan groups and primary sellers can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q9_some_fans_who_would_have_bought_on_resal": {
   "text": "Some fans who would have bought on resale at the market price now try to buy in the primary sale, including demand-priced seats.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q10_some_fans_of_a_touring_act_substitute_th": {
   "text": "Some fans of a touring act substitute the Brackmere City stop for Dunholt.",
   "p": 0.55,
   "class": "substitutability"
  },
  "q11_under_the_attorney_general_s_existing_pr": {
   "text": "Under the Attorney General's existing practice, packages whose other items carry most of the price are not treated as tickets, so some sellers use them, and add-ons sold with tickets get past platforms' screening.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q12_the_expected_penalty_for_individual_abov": {
   "text": "The expected penalty for individual above-cap resales outside compliant platforms is small enough that some take place.",
   "p": 0.8,
   "class": "enforcement"
  },
  "q13_some_brokers_keep_reselling_selvar_ticke": {
   "text": "Some brokers keep reselling Selvar tickets outside the cap and keep using bots for it.",
   "p": 0.6,
   "class": "other"
  },
  "q14_brokers_shift_some_of_their_buying_from_": {
   "text": "Brokers shift some of their buying from Selvar to Brackmere City events.",
   "p": 0.6,
   "class": "mobility"
  },
  "q15_brokers_purchases_in_primary_sales_are_m": {
   "text": "Brokers' purchases in primary sales are made mainly to resell above face value, so the cap removes most of their gain on Selvar high-demand events.",
   "p": 0.75,
   "class": "other"
  },
  "q16_brokers_bought_a_material_share_of_deman": {
   "text": "Brokers bought a material share of demand-priced seats, so their withdrawal lowers demand for them.",
   "p": 0.4,
   "class": "other"
  },
  "q17_brokers_hold_about_15_of_season_tickets_": {
   "text": "Brokers hold about 15% of season tickets mainly to resell single games, and renew fewer once resale is capped.",
   "p": 0.7,
   "class": "other"
  },
  "q18_the_season_seats_released_by_brokers_abo": {
   "text": "The season seats released (by brokers, about 5,700 at most, and by other holders who renew less now that resale is capped) are fewer than the waiting-list members who still buy at the club's price.",
   "p": 0.75,
   "class": "other"
  },
  "q19_broker_businesses_are_valued_on_expected": {
   "text": "Broker businesses are valued on expected earnings, and buyers of them expected the cap from introduction.",
   "p": 0.6,
   "class": "expectations"
  },
  "q20_platforms_cut_the_services_they_provide_": {
   "text": "Platforms cut the services they provide to buyers when the fee they may charge is capped.",
   "p": 0.55,
   "class": "other"
  },
  "q21_platforms_raise_the_fee_they_charge_to_s": {
