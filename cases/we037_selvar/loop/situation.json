 "unclear": [
  {
   "id": "U1",
   "text": "Section 3 caps the price of a resale at face value plus 10%; section 5 says nothing prevents a platform from charging a reasonable fee for its services.",
   "readings": [
    "U1-a: platform fees charged to the buyer are part of the price, so the buyer pays at most face value plus 10% in total",
    "U1-b: platform fees are charged on top of the capped price, and reasonable is not defined"
