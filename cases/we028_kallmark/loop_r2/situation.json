 "assumptions": {
  "a1": {
   "text": "Without the Act, landings would stay well above 40,000 tonnes a year, so the cap binds from 2028.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Landings are recorded and overages enforced at the designated sites.",
   "class": "enforcement",
   "p": 0.8
  },
  "a4": {
   "text": "Owners know the formula from the introduction of the bill, expect passage, and have idle vessels or spare capacity to land more in 2026 and 2027.",
   "class": "expectations",
   "p": 0.8
  },
  "a13": {
   "text": "The 8% limit binds for a few of the largest firms.",
   "class": "binding",
   "p": 0.55
  },
  "a22": {
   "text": "The Directorate's budget is raised by the stated 18 million marks.",
   "class": "revenue_use",
   "p": 0.9
  },
  "s1": {
   "text": "The register of transfers refuses holders who own no registered vessel.",
   "class": "enforcement",
   "p": 0.9
  },
  "s2": {
   "text": "Owners cannot recover the crew's larger share through other terms of the crew agreement.",
   "class": "other",
   "p": 0.6
  },
  "q8_fresh_fish_buyers_turn_to_saithe_and_lin": {
   "text": "Fresh-fish buyers turn to saithe and ling when ridge cod costs more.",
   "p": 0.7,
   "class": "other"
  },
  "q9_fresh_local_ridge_cod_is_only_partly_sub": {
   "text": "Fresh local ridge cod is only partly substitutable with imported or frozen whitefish.",
   "p": 0.7,
   "class": "other"
  },
  "q10_recipients_processors_and_crew_can_organ": {
   "text": "Recipients, processors and crew can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q11_anyone_can_register_a_seaworthy_vessel_f": {
   "text": "Anyone can register a seaworthy vessel for 600 marks a year, so non-owners can qualify to hold shares.",
   "p": 0.85,
   "class": "other"
  },
  "q12_processors_value_secure_supply_enough_to": {
   "text": "Processors value secure supply enough to buy a vessel in order to hold shares.",
   "p": 0.6,
   "class": "other"
  },
  "q13_the_plants_cannot_fully_replace_ridge_co": {
   "text": "The plants cannot fully replace ridge cod with other species.",
   "p": 0.7,
   "class": "other"
  },
  "q14_the_fall_in_kallmark_s_exports_about_a_s": {
   "text": "The fall in Kallmark's exports (about a sixth of a 7% share) moves the North Basin whitefish price by more than a negligible amount.",
   "p": 0.6,
   "class": "other"
  },
  "q15_foreign_sellers_of_saithe_and_haddock_ca": {
   "text": "Foreign sellers of saithe and haddock can sell more in the North Basin market when Kallmark sells less (from other markets, stocks or catch not yet taken).",
   "p": 0.6,
   "class": "other"
  },
  "q16_the_plants_are_specific_to_ridge_cod_and": {
   "text": "The plants are specific to ridge cod and compete for the fish landed, while their output is priced in the wider market.",
   "p": 0.6,
   "class": "other"
  },
  "q17_costs_per_tonne_differ_materially_among_": {
   "text": "Costs per tonne differ materially among vessels, and transfers are not blocked for most owners by the 8% limit.",
   "p": 0.8,
   "class": "other"
  },
  "q18_large_ridge_cod_sell_for_more_per_kilo_t": {
   "text": "Large ridge cod sell for more per kilo than small ones above 35 cm, and the gear catches mixed sizes.",
   "p": 0.85,
   "class": "other"
  },
  "q19_with_observers_on_10_of_trawler_trips_an": {
   "text": "With observers on 10% of trawler trips and none on coastal boats, discarding is rarely detected.",
   "p": 0.75,
   "class": "other"
  },
  "q20_the_ten_small_harbors_are_monitored_only": {
   "text": "The ten small harbors are monitored only at scheduled hours, so some landings go unrecorded.",
   "p": 0.55,
   "class": "other"
  },
  "q21_a_vessel_s_history_passes_to_its_buyer_a": {
   "text": "A vessel's history passes to its buyer, and buyers price it in.",
   "p": 0.85,
   "class": "other"
  },
  "q22_owners_expect_the_bill_to_pass_and_the_s": {
   "text": "Owners expect the bill to pass and the shares to keep their value past the 2033 review.",
   "p": 0.7,
   "class": "other"
  },
  "q23_large_holders_can_lease_tonnage_beyond_t": {
   "text": "Large holders can lease tonnage beyond the shares they may hold.",
   "p": 0.75,
   "class": "other"
  },
  "q24_without_the_act_some_owners_not_now_fish": {
   "text": "Without the Act, some owners not now fishing ridge cod would enter the open fishery from 2028.",
   "p": 0.7,
   "class": "other"
  },
  "q25_vessels_and_crew_have_other_uses_the_ope": {
   "text": "Vessels and crew have other uses: the open saithe and ling fisheries, or sale abroad.",
   "p": 0.7,
   "class": "other"
  },
  "q26_ridge_cod_is_landed_as_saithe_or_ling_on": {
   "text": "Ridge cod is landed as saithe or ling on a meaningful scale.",
   "p": 0.35,
   "class": "other"
  },
  "q27_the_surplus_vessels_are_not_absorbed_by_": {
   "text": "The surplus vessels are not absorbed by other fisheries and buyers abroad at unchanged prices.",
   "p": 0.6,
   "class": "other"
  },
  "q28_kallmark_s_ridge_cod_is_a_small_part_of_": {
   "text": "Kallmark's ridge cod is a small part of the North Basin market, with close substitutes.",
   "p": 0.8,
   "class": "other"
  }
 }
}