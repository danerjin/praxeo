 "assumptions": {
  "a1": {
   "text": "Without the Act, landings would stay well above 40,000 tonnes a year, so the cap binds from 2028.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Landings are recorded and overages enforced at the designated sites.",
   "class": "enforcement",
   "p": 0.8
  },
  "a4": {
   "text": "Owners know the formula from the introduction of the bill, expect passage, and have idle vessels or spare capacity to land more in 2026 and 2027.",
   "class": "expectations",
   "p": 0.8
  },
  "a22": {
   "text": "The Directorate's budget is raised by the stated 18 million marks.",
   "class": "revenue_use",
   "p": 0.9
  },
  "a_k3": {
   "text": "Vessel owners cannot recover the crew's share of quota costs through the other terms of the crew contract.",
   "class": "other",
   "p": 0.7
  },
  "q6_fresh_fish_buyers_turn_to_saithe_and_lin": {
   "text": "Fresh-fish buyers turn to saithe and ling when ridge cod costs more.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q7_fresh_local_ridge_cod_is_only_partly_sub": {
   "text": "Fresh local ridge cod is only partly substitutable with imported or frozen whitefish.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q8_recipients_processors_and_crew_can_organ": {
   "text": "Recipients, processors and crew can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q9_vessels_and_crew_have_other_uses_the_ope": {
   "text": "Vessels and crew have other uses: the open saithe and ling fisheries, or sale abroad.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q10_the_plants_can_replace_some_ridge_cod_wi": {
   "text": "The plants can replace some ridge cod with other species.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q11_processors_value_secure_supply_enough_to": {
   "text": "Processors value secure supply enough to buy a vessel in order to hold shares.",
   "p": 0.6,
   "class": "other"
  },
  "q12_the_fall_in_kallmark_s_exports_about_a_s": {
   "text": "The fall in Kallmark's exports (about a sixth of a 7% share) moves the North Basin whitefish price by more than a negligible amount.",
   "p": 0.6,
   "class": "other"
  },
  "q13_foreign_sellers_of_saithe_and_haddock_ca": {
   "text": "Foreign sellers of saithe and haddock can sell more in the North Basin market when Kallmark sells less (from other markets, stocks or catch not yet taken).",
   "p": 0.6,
   "class": "substitutability"
  },
  "q14_the_plants_are_specific_to_ridge_cod_and": {
   "text": "The plants are specific to ridge cod and compete for the fish landed, while their output is priced in the wider market.",
   "p": 0.6,
   "class": "alternative_uses"
  },
  "q15_the_plants_cannot_fully_replace_ridge_co": {
   "text": "The plants cannot fully replace ridge cod with other species.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q16_large_ridge_cod_sell_for_more_per_kilo_t": {
   "text": "Large ridge cod sell for more per kilo than small ones above 35 cm, and the gear catches mixed sizes.",
   "p": 0.85,
   "class": "enforcement"
  },
  "q17_with_observers_on_10_of_trawler_trips_an": {
   "text": "With observers on 10% of trawler trips and none on coastal boats, discarding is rarely detected.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q18_the_ten_small_harbors_are_monitored_only": {
   "text": "The ten small harbors are monitored only at scheduled hours, so some landings go unrecorded.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q19_ridge_cod_is_landed_as_saithe_or_ling_on": {
   "text": "Ridge cod is landed as saithe or ling on a meaningful scale.",
   "p": 0.35,
   "class": "enforcement"
  },
  "q20_crew_on_most_vessels_are_paid_by_the_lay": {
   "text": "Crew on most vessels are paid by the lay, a fixed share of each trip's revenue after trip expenses.",
   "p": 0.9,
   "class": "other"
  },
  "q21_costs_per_tonne_differ_materially_among_": {
   "text": "Costs per tonne differ materially among vessels, and transfers are not blocked for most owners by the 8% limit.",
   "p": 0.8,
   "class": "other"
  },
  "q22_some_recipients_sell_shares_realizing_th": {
   "text": "Some recipients sell shares, realizing their value.",
   "p": 0.8,
   "class": "other"
  },
  "q23_the_surplus_vessels_are_not_absorbed_by_": {
   "text": "The surplus vessels are not absorbed by other fisheries and buyers abroad at unchanged prices.",
   "p": 0.6,
   "class": "other"
  },
  "q24_kallmark_s_ridge_cod_is_a_small_part_of_": {
   "text": "Kallmark's ridge cod is a small part of the North Basin market, with close substitutes.",
   "p": 0.8,
   "class": "substitutability"
  }
 }
}