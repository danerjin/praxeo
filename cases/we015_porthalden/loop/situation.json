 "assumptions": {
  "a1": {
   "text": "Demand keeps growing about 3% a year, so at the meter rate the fixed fleet falls short of demand within about two years, and more so each year.",
   "p": 0.8,
   "class": "binding"
  },
  "a2": {
   "text": "Drivers cannot simply charge above the meter on metered trips.",
   "p": 0.8,
   "class": "enforcement"
  },
  "a4": {
   "text": "Applicants know the cap will count licenses outstanding on the effective date, and can get a license within five months.",
   "p": 0.8,
   "class": "expectations"
  },
  "a16": {
   "text": "The Office's budget rises with the added enforcement work, rather than the 12 inspectors being moved from other duties.",
   "p": 0.55,
   "class": "revenue_use"
  },
  "j1": {
   "text": "The cap on licenses is enforced against unlicensed street-hail and rank service.",
   "p": 0.8,
   "class": "enforcement"
  },
  "j2": {
   "text": "The 12 inspectors are moved from other duties rather than the Office's budget rising.",
   "p": 0.45,
   "class": "revenue_use"
  },
  "q7_transit_and_private_hire_are_acceptable_": {
   "text": "Transit and private hire are acceptable substitutes for some taxi trips.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q8_taxi_trips_are_allocated_first_come_at_r": {
   "text": "Taxi trips are allocated first come at ranks and by hail, so fewer cabs relative to riders shows as longer waits.",
   "p": 0.9,
   "class": "other"
  },
  "q9_refusals_of_hails_and_trips_are_hard_to_": {
   "text": "Refusals of hails and trips are hard to detect and punish.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q10_unlicensed_service_and_off_meter_deals_o": {
   "text": "Unlicensed service and off-meter deals often go undetected.",
   "p": 0.75,
   "class": "enforcement"
  },
  "q11_vehicle_and_service_standards_leave_room": {
   "text": "Vehicle and service standards leave room above the legal minimum.",
   "p": 0.8,
   "class": "other"
  },
  "q12_the_30_minute_booking_rule_is_loosely_en": {
   "text": "The 30-minute booking rule is loosely enforced.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q13_some_would_be_taxi_drivers_shut_out_by_t": {
   "text": "Some would-be taxi drivers shut out by the cap can and do operate as private hire instead.",
   "p": 0.75,
   "class": "alternative_uses"
  },
  "q14_would_be_taxi_drivers_next_best_work_pay": {
   "text": "Would-be taxi drivers' next-best work pays less in money than driving under open entry would have.",
   "p": 0.6,
   "class": "other"
  },
  "q15_medallion_holders_can_organize_at_a_cost": {
   "text": "Medallion holders can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q16_many_licensed_cabs_are_driven_by_lessees": {
   "text": "Many licensed cabs are driven by lessees who pay the medallion holder, rather than by the holders themselves.",
   "p": 0.7,
   "class": "other"
  },
  "q17_medallion_holders_and_buyers_expect_the_": {
   "text": "Medallion holders and buyers expect the cap to last.",
   "p": 0.75,
   "class": "expectations"
  },
  "q18_private_hire_supply_cannot_expand_within": {
   "text": "Private-hire supply cannot expand within the first months to meet the added bookings.",
   "p": 0.35,
   "class": "other"
  },
  "q19_disguised_street_hail_service_by_private": {
   "text": "Disguised street-hail service by private-hire cars relieves only part of the shortage of cabs.",
   "p": 0.85,
   "class": "other"
  },
  "q20_app_services_take_enough_trips_that_meda": {
   "text": "App services take enough trips that medallion prices fall below what buyers near the peak paid.",
   "p": 0.6,
   "class": "expectations"
  }
 }
