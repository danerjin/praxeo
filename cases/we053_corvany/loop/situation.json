 "assumptions": {
  "a1": {
   "text": "The requirement binds: many covered controllers would host abroad without it.",
   "p": 0.95,
   "class": "binding"
  },
  "a2": {
   "text": "The Office enforces the requirement against controllers with an establishment in Corvany.",
   "p": 0.85,
   "class": "enforcement"
  },
  "a10": {
   "text": "The cost of compliance is material against the gain from growing past 50,000.",
   "p": 0.8,
   "class": "binding"
  },
  "a18": {
   "text": "For some small facilities, the certificate and audit cost more than the margin on hosting covered data.",
   "p": 0.55,
   "class": "other"
  },
  "a22": {
   "text": "The supplementary appropriation is paid from the general budget, with no named tax.",
   "p": 0.9,
   "class": "revenue_use"
  },
  "a27": {
   "text": "Actors expect the requirement to apply from 1 January 2029, as enacted.",
   "p": 0.95,
   "class": "expectations"
  },
  "q7_some_controllers_above_the_threshold_con": {
   "text": "Some controllers above the threshold continue to pay higher costs rather than drop below it.",
   "p": 0.9,
   "class": "other"
  },
  "q8_at_least_one_foreign_provider_builds_a_l": {
   "text": "At least one foreign provider builds a local region.",
   "p": 0.85,
   "class": "expectations"
  },
  "q9_local_computing_costs_more_per_unit_than": {
   "text": "Local computing costs more per unit than the Esterland regions.",
   "p": 0.85,
   "class": "other"
  },
  "q10_local_hosting_cuts_latency_for_corvany_u": {
   "text": "Local hosting cuts latency for Corvany users, which some controllers value.",
   "p": 0.7,
   "class": "other"
  },
  "q11_new_local_regions_launch_with_fewer_serv": {
   "text": "New local regions launch with fewer services than the Esterland regions; colocation offers fewer still.",
   "p": 0.6,
   "class": "other"
  },
  "q12_for_some_controllers_near_50_000_deletin": {
   "text": "For some controllers near 50,000, deleting inactive records or splitting between controllers costs less than compliance.",
   "p": 0.75,
   "class": "other"
  },
  "q13_the_office_does_not_treat_a_group_s_cont": {
   "text": "The Office does not treat a group's controllers as one.",
   "p": 0.6,
   "class": "other"
  },
  "q14_covered_controllers_pay_consultants_to_m": {
   "text": "Covered controllers pay consultants to migrate their systems.",
   "p": 0.9,
   "class": "other"
  },
  "q15_hosting_is_a_material_part_of_the_cost_o": {
   "text": "Hosting is a material part of the cost of online services.",
   "p": 0.75,
   "class": "other"
  },
  "q16_some_controllers_that_keep_backups_abroa": {
   "text": "Some controllers that keep backups abroad would store them in Corvany if required.",
   "p": 0.85,
   "class": "other"
  },
  "q17_some_foreign_online_services_find_corvan": {
   "text": "Some foreign online services find Corvany too small to justify local hosting, and cap sign-ups or withdraw.",
   "p": 0.7,
   "class": "alternative_uses"
  },
  "q18_enforcement_against_foreign_services_wit": {
   "text": "Enforcement against foreign services without an establishment is weak.",
   "p": 0.7,
   "class": "enforcement"
  },
  "q19_domestic_services_that_host_locally_are_": {
   "text": "Domestic services that host locally are substitutes for some foreign services that withdraw.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q20_local_operators_providers_and_controller": {
   "text": "Local operators, providers and controllers near the line can organize at a cost below their stake.",
   "p": 0.85,
   "class": "other"
  },
  "q21_local_colocation_cannot_add_space_beyond": {
   "text": "Local colocation cannot add space beyond its 15% free capacity within a year.",
   "p": 0.8,
   "class": "durability"
  },
  "q22_local_capacity_can_be_added_at_some_cost": {
   "text": "Local capacity can be added at some cost: colocation expansions and connections below 10 MW within about a year.",
   "p": 0.8,
   "class": "alternative_uses"
  },
  "q23_the_esterland_regions_capacity_is_not_cu": {
   "text": "The Esterland regions' capacity is not cut as fast as Corvany workloads leave.",
   "p": 0.7,
   "class": "durability"
  },
  "q24_some_providers_that_covered_controllers_": {
   "text": "Some providers that covered controllers used do not build in Corvany.",
   "p": 0.8,
   "class": "other"
  },
  "q25_some_controllers_that_already_host_in_co": {
   "text": "Some controllers that already host in Corvany colocation, covered or not, move to a provider's local region when it opens.",
   "p": 0.65,
   "class": "substitutability"
  },
  "q26_covered_controllers_move_other_operation": {
   "text": "Covered controllers move other operations (staff, offices) to Corvany along with their data.",
   "p": 0.2,
   "class": "other"
  },
  "q27_the_providers_investment_is_financed_fro": {
   "text": "The providers' investment is financed from abroad, and servers and equipment are imported.",
   "p": 0.8,
   "class": "other"
  },
  "q28_large_capacity_cannot_be_added_at_the_ol": {
   "text": "Large capacity cannot be added at the old cost within five years, and the cost of adding it does not fall as more is added.",
   "p": 0.65,
   "class": "durability"
  }
 }
}