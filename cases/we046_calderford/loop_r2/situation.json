 "assumptions": {
  "a1": {
   "text": "Some drivers who now enter the zone on weekdays value the day there by less than $15 more than its other costs, at today's speeds (the charge binds, and the response is partial).",
   "class": "binding",
   "p": 0.95
  },
  "a2": {
   "text": "The charge is enforced: cameras read most plates and penalties are collected.",
   "class": "enforcement",
   "p": 0.85
  },
  "a12": {
   "text": "Some deliveries cannot be completed within 30 minutes (installations, large drops, multi-drop rounds).",
   "class": "other",
   "p": 0.85
  },
  "a14": {
   "text": "Carriers have better alternatives (customers elsewhere) than zone businesses have (premises elsewhere).",
   "class": "substitutability",
   "p": 0.65
  },
  "a24": {
   "text": "The PAO's budget is not raised for the new appeals, and its net caseload rises (about 9,000 new appeals against about 2,800 fewer).",
   "class": "revenue_use",
   "p": 0.8
  },
  "a33": {
   "text": "Some zone residents value keeping a car at a zone address by less than $1.50 a weekday more than their next-best (giving it up, keeping it outside the zone, moving out).",
   "class": "substitutability",
   "p": 0.6
  },
  "a36": {
   "text": "Drivers, carriers and residents expect the charge to start on 1 November 2027 as enacted.",
   "class": "expectations",
   "p": 0.9
  },
  "q8_some_carriers_can_consolidate_zone_deliv": {
   "text": "Some carriers can consolidate zone deliveries into fewer van-days (more drops per charged day).",
   "p": 0.7,
   "class": "other"
  },
  "q9_under_u1_b_some_rounds_can_be_reshaped_i": {
   "text": "Under U1-b some rounds can be reshaped into visits under 30 minutes.",
   "p": 0.7,
   "class": "other"
  },
  "q10_zone_retailers_delivery_firms_ringside_r": {
   "text": "Zone retailers, delivery firms, Ringside residents and the transit union can organize at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q11_some_drivers_switch_to_bus_tram_or_rings": {
   "text": "Some drivers switch to bus, tram or Ringside parking.",
   "p": 0.9,
   "class": "substitutability"
  },
  "q12_for_most_who_switch_the_trip_by_bus_or_b": {
   "text": "For most who switch, the trip by bus or by Ringside parking and walking takes longer than by car.",
   "p": 0.8,
   "class": "substitutability"
  },
  "q13_the_gap_in_door_to_door_time_between_car": {
   "text": "The gap in door-to-door time between car and bus far exceeds what faster roads save the bus (15 minutes against a few).",
   "p": 0.75,
   "class": "substitutability"
  },
  "q14_some_shoppers_who_drove_into_the_zone_bu": {
   "text": "Some shoppers who drove into the zone buy instead in Ringside or Merrowdale, where they can park.",
   "p": 0.7,
   "class": "other"
  },
  "q15_some_weekday_trips_can_move_to_before_7_": {
   "text": "Some weekday trips can move to before 7:00, after 19:00 or to weekends.",
   "p": 0.7,
   "class": "other"
  },
  "q16_some_through_traffic_diverts_to_the_inne": {
   "text": "Some through traffic diverts to the Inner Ring Road.",
   "p": 0.85,
   "class": "mobility"
  },
  "q17_for_most_diverted_through_trips_going_ro": {
   "text": "For most diverted through trips, going round on the Inner Ring Road takes longer than crossing the zone did.",
   "p": 0.75,
   "class": "mobility"
  },
  "q18_some_drivers_switch_to_ride_hail_or_taxi": {
   "text": "Some drivers switch to ride-hail or taxis.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q19_some_people_who_work_in_the_zone_and_dri": {
   "text": "Some people who work in the zone and drive would move into it to pay $1.50 rather than $15.",
   "p": 0.55,
   "class": "mobility"
  },
  "q20_some_non_residents_can_register_a_vehicl": {
   "text": "Some non-residents can register a vehicle to a zone address without detection.",
   "p": 0.6,
   "class": "enforcement"
  },
  "q21_some_drivers_evade_foreign_cloned_or_obs": {
   "text": "Some drivers evade (foreign, cloned or obscured plates).",
   "p": 0.6,
   "class": "enforcement"
  },
  "q22_fewer_vehicles_in_the_zone_raise_speeds_": {
   "text": "Fewer vehicles in the zone raise speeds for those that remain.",
   "p": 0.85,
   "class": "other"
  },
  "q23_for_most_car_trips_into_the_zone_the_tim": {
   "text": "For most car trips into the zone, the time saved by faster roads is worth much less than $15.",
   "p": 0.8,
   "class": "other"
  },
  "q24_zone_garages_cannot_be_converted_to_othe": {
   "text": "Zone garages cannot be converted to other uses within a year.",
   "p": 0.8,
   "class": "durability"
  },
  "q25_buyers_of_property_expect_the_charge_to_": {
   "text": "Buyers of property expect the charge to last.",
   "p": 0.75,
   "class": "durability"
  },
  "q26_some_residents_who_drive_in_the_zone_wou": {
   "text": "Some residents who drive in the zone would have moved out of it within a few years.",
   "p": 0.6,
   "class": "substitutability"
  },
  "q27_ride_hail_supply_into_the_zone_at_peak_c": {
   "text": "Ride-hail supply into the zone at peak cannot expand at an unchanged cost at once.",
   "p": 0.6,
   "class": "durability"
  },
  "q28_the_council_reduces_general_fund_support": {
   "text": "The council reduces general-fund support for buses below what it would otherwise have been (no maintenance-of-effort clause).",
   "p": 0.7,
   "class": "revenue_use"
  },
  "q29_the_loss_of_car_shoppers_dominates_the_g": {
   "text": "The loss of car shoppers dominates the gain from new visitors in zone sales.",
   "p": 0.4,
   "class": "other"
  },
  "q30_calderford_transit_cannot_add_buses_for_": {
   "text": "Calderford Transit cannot add buses for at least a year (14 to 18 months to order).",
   "p": 0.8,
   "class": "durability"
  },
  "q31_more_frequent_buses_bring_to_zone_shops_": {
   "text": "More frequent buses bring to zone shops some visitors who would not otherwise have come.",
   "p": 0.55,
   "class": "other"
  },
  "q32_at_a_given_number_of_vehicles_in_the_zon": {
   "text": "At a given number of vehicles in the zone, travel time is the same with and without the charge: the roads, signals and parking are unchanged, and the extra buses from the earmark add to congestion rather than relieve it.",
   "p": 0.8,
   "class": "other"
  },
  "q33_general_fund_support_for_buses_is_cut_by": {
   "text": "General-fund support for buses is cut by less than the earmark, so bus service rises.",
   "p": 0.7,
   "class": "revenue_use"
  },
  "q34_each_ride_hail_car_day_added_carries_the": {
   "text": "Each ride-hail car-day added carries the trips of more than one former private car-day, so switching to ride-hail lowers the total of vehicle-days.",
   "p": 0.8,
   "class": "other"
  },
  "q35_some_zone_workers_commute_by_car_and_can": {
   "text": "Some zone workers commute by car and cannot switch cheaply, and zone employers compete with employers elsewhere for them.",
   "p": 0.55,
   "class": "other"
  },
  "q36_housing_in_the_zone_cannot_be_expanded_w": {
   "text": "Housing in the zone cannot be expanded within a few years.",
   "p": 0.9,
   "class": "other"
  },
  "q37_ringside_s_garages_about_88_full_cannot_": {
   "text": "Ringside's garages, about 88% full, cannot add spaces within a year.",
   "p": 0.75,
   "class": "durability"
  }
 }
}