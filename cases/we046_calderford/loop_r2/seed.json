 "assumptions": {
  "a1": {"text": "Some drivers who now enter the zone on weekdays value the day there by less than $15 more than its other costs, at today's speeds (the charge binds, and the response is partial).", "class": "binding", "p": 0.95},
  "a2": {"text": "The charge is enforced: cameras read most plates and penalties are collected.", "class": "enforcement", "p": 0.85},
  "a12": {"text": "Some deliveries cannot be completed within 30 minutes (installations, large drops, multi-drop rounds).", "class": "other", "p": 0.85},
  "a14": {"text": "Carriers have better alternatives (customers elsewhere) than zone businesses have (premises elsewhere).", "class": "substitutability", "p": 0.65},
  "a24": {"text": "The PAO's budget is not raised for the new appeals, and its net caseload rises (about 9,000 new appeals against about 2,800 fewer).", "class": "revenue_use", "p": 0.8},
  "a33": {"text": "Some zone residents value keeping a car at a zone address by less than $1.50 a weekday more than their next-best (giving it up, keeping it outside the zone, moving out).", "class": "substitutability", "p": 0.6},
  "a36": {"text": "Drivers, carriers and residents expect the charge to start on 1 November 2027 as enacted.", "class": "expectations", "p": 0.9}
