 "assumptions": {
  "a1": {"text": "Some drivers who now enter the zone on weekdays value the day there by less than $15 more than its other costs, at today's speeds (the charge binds, and the response is partial).", "class": "binding", "p": 0.95},
  "a2": {"text": "The charge is enforced: cameras read most plates and penalties are collected.", "class": "enforcement", "p": 0.85},
  "a14": {"text": "Carriers have better alternatives (customers elsewhere) than zone businesses have (premises elsewhere).", "class": "substitutability", "p": 0.65},
  "a19": {"text": "Some zone workers commute by car and cannot switch cheaply, and zone employers compete with employers elsewhere for them.", "class": "other", "p": 0.55},
