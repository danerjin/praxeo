 "assumptions": {
  "a1": {
   "text": "About 38% of private employees lack paid leave usable for illness, so the term binds for them.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Most bound employers comply: payroll vendors build in accrual, and some workers complain.",
   "class": "enforcement",
   "p": 0.7
  },
  "a3": {
   "text": "Money wages are fixed in the short run by pay scales, annual raises and collective agreements.",
   "class": "other",
   "p": 0.8
  },
  "a5": {
   "text": "Wages above the minimum can adjust over the medium horizon, as raises are set.",
   "class": "other",
   "p": 0.8
  },
  "a6": {
   "text": "For the marginal worker and employer, the term is worth less to the worker than it costs the employer: they could have agreed on it and did not.",
   "class": "other",
   "p": 0.6
  },
  "a7": {
   "text": "The minimum wage binds for some uncovered workers.",
   "class": "binding",
   "p": 0.85
  },
  "a8": {
   "text": "Employers can move hours between part-time and full-time staff.",
   "class": "other",
   "p": 0.7
  },
  "a10": {
   "text": "Some firms near six employees value staying exempt more than an extra hire.",
   "class": "other",
   "p": 0.6
  },
  "a12": {
   "text": "Some existing PTO policies do not meet the K2 conditions (documentation, notice, increments, attendance points).",
   "class": "other",
   "p": 0.8
  },
  "a20": {
   "text": "The $3.4 million is new money from the general fund.",
   "class": "revenue_use",
   "p": 0.9
  },
  "a22": {
   "text": "Over the medium to long run, workers' alternatives to bound employment (small firms, contracting, Pellam) are clearly worse than employers' alternatives (automation, redeployment, Pellam).",
   "class": "mobility",
   "p": 0.6
  },
  "a25": {
   "text": "Owners of firms near six employees know from mid-2026 that the 2026 average decides their 2027 status.",
   "class": "expectations",
   "p": 0.7
  },
  "q13_complaints_are_unlikely_for_some_workers": {
   "text": "Complaints are unlikely for some workers: short tenure, unaware of the law, fearing retaliation, or owed small sums.",
   "p": 0.8,
   "class": "enforcement"
  },
  "q14_the_classification_test_is_weakly_enforc": {
   "text": "The classification test is weakly enforced in some occupations, so contractor arrangements are open to some employers.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q15_shift_based_employers_cover_absent_shift": {
   "text": "Shift-based employers cover absent shifts, partly through agencies and on-call staff.",
   "p": 0.65,
   "class": "other"
  },
  "q16_employers_end_seasonal_and_temporary_eng": {
   "text": "Employers end seasonal and temporary engagements before 90 days to avoid use.",
   "p": 0.4,
   "class": "other"
  },
  "q17_employers_can_infer_expected_use_of_sick": {
   "text": "Employers can infer expected use of sick time from what they see of applicants, and cannot set pay worker by worker to match it.",
   "p": 0.55,
   "class": "other"
  },
  "q18_most_competitors_of_local_service_seller": {
   "text": "Most competitors of local service sellers are bound too (in Varrow, six or more employees).",
   "p": 0.7,
   "class": "other"
  },
  "q19_varrow_s_tradable_producers_compete_with": {
   "text": "Varrow's tradable producers compete with Pellam producers, who are not bound.",
   "p": 0.65,
   "class": "mobility"
  },
  "q20_compliant_and_small_firms_compete_in_pro": {
   "text": "Compliant and small firms compete in product markets with uncovered firms.",
   "p": 0.6,
   "class": "substitutability"
  },
