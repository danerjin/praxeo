  {
   "id": "U1",
   "text": "Carry-over in the first year: K3 is enforced from 1 January 2028.",
   "readings": [
    "U1-a: hours accrued in 2027 and unused on 31 December 2027 must carry into 2028; only enforcement waits",
    "U1-b: K3 applies only to hours accrued from 2028, so an employer may let 2027 hours lapse"
   ],
   "components": {
    "U1-a": [
     "k3"
    ],
    "U1-b": []
   }
  },
