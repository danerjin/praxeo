 "assumptions": {
  "a_1": {
   "text": "About 135,000 full-timers at firms of 50+ FTE are offered nothing, and about 105,000 are offered less than K1 requires, so K1 binds for them.",
   "p": 0.9,
   "class": "binding"
  },
  "a_2": {
   "text": "Some bound firms that offer nothing now choose to offer.",
   "p": 0.75,
   "class": "other"
  },
  "a_3": {
   "text": "Money wages are fixed in the short run by pay scales and yearly raises.",
   "p": 0.75,
   "class": "other"
  },
  "a_4": {
   "text": "Some bound firms choose to pay the charge for at least some full-timers.",
   "p": 0.9,
   "class": "other"
  },
  "a_5": {
   "text": "Some firms with plans short of K1 upgrade them rather than pay.",
   "p": 0.7,
   "class": "other"
  },
  "a_6": {
   "text": "Wages above the minimum can adjust over the medium horizon, as raises are set.",
   "p": 0.8,
   "class": "other"
  },
  "a_7": {
   "text": "At players, for the marginal pair, cover at 30% is worth less to the worker than its cost to the employer.",
   "p": 0.6,
   "class": "other"
  },
  "a_8": {
   "text": "Workers at payers have some alternative to bound full-time work, so the wage does not fall by the whole charge.",
   "p": 0.85,
   "class": "mobility"
  },
  "a_9": {
   "text": "The minimum wage binds for some workers at bound firms.",
   "p": 0.85,
   "class": "binding"
  },
  "a_10": {
   "text": "Some employers can reschedule jobs from 30 to 35 hours to under 30 at a cost below the per-head cost.",
   "p": 0.75,
   "class": "other"
  },
  "a_14": {
   "text": "Some firms near 50 FTE value staying below the line more than the extra work.",
   "p": 0.7,
   "class": "other"
  },
  "a_15": {
   "text": "Owners of firms near 50 know from January 2027 that the 2027 average decides 2028 status.",
   "p": 0.75,
   "class": "expectations"
  },
  "a_18": {
   "text": "Revenue cannot cheaply verify reported offers, and some firms report offers not made.",
   "p": 0.55,
   "class": "enforcement"
  },
  "a_21": {
   "text": "Business values reflect expected earnings, and buyers expected the Act from its introduction.",
   "p": 0.7,
   "class": "expectations"
  },
  "a_23": {
   "text": "Over the medium to long run, workers' alternatives to bound employment are clearly worse than employers' alternatives.",
   "p": 0.6,
   "class": "mobility"
  },
  "a_29": {
   "text": "The $4.1 million is new general-fund money.",
   "p": 0.9,
   "class": "revenue_use"
  },
  "a_33": {
   "text": "Some of the 380 seasonal firms do not offer qualifying cover to their full-timers.",
   "p": 0.75,
   "class": "binding"
  },
  "q18_some_bound_employers_can_staff_work_with": {
   "text": "Some bound employers can staff work with more employees averaging under 30 hours instead of full-timers.",
   "p": 0.8,
   "class": "other"
  },
  "q19_some_bound_employers_can_contract_out_cl": {
   "text": "Some bound employers can contract out cleaning, security or food service to firms under 50 FTE.",
   "p": 0.84,
   "class": "other"
  },
  "q20_bound_employers_set_the_prices_of_what_t": {
   "text": "Bound employers set the prices of what they sell partly from their labour costs.",
   "p": 0.8,
   "class": "other"
  },
  "q21_some_firms_near_50_fte_can_meet_extra_wo": {
   "text": "Some firms near 50 FTE can meet extra work with longer hours from existing full-timers.",
   "p": 0.67,
   "class": "other"
  },
  "q22_hours_above_130_a_month_by_an_employee_a": {
   "text": "Hours above 130 a month by an employee already counted as one FTE add nothing to the firm's FTE count.",
   "p": 0.95,
   "class": "other"
  },
  "q23_some_firms_near_50_fte_can_use_agency_wo": {
   "text": "Some firms near 50 FTE can use agency workers instead of hiring their own employees.",
   "p": 0.8,
   "class": "other"
  },
  "q24_agency_workers_count_toward_the_agency_s": {
   "text": "Agency workers count toward the agency's FTE rather than the client firm's.",
   "p": 0.96,
   "class": "other"
  },
  "q25_some_seasonal_firms_can_split_a_season_s": {
   "text": "Some seasonal firms can split a season's work among more workers each employed for 60 days or less.",
   "p": 0.7,
   "class": "other"
  },
  "q26_a_worker_employed_for_60_days_or_less_is": {
   "text": "A worker employed for 60 days or less is owed no offer under K1.",
   "p": 0.93,
   "class": "other"
  },
  "q27_some_seasonal_firms_can_staff_seasonal_w": {
   "text": "Some seasonal firms can staff seasonal work with more workers averaging under 30 hours instead of full-timers.",
   "p": 0.7,
   "class": "other"
  },
  "q28_ski_and_lake_resorts_set_their_prices_pa": {
   "text": "Ski and lake resorts set their prices partly from their labour costs.",
   "p": 0.75,
   "class": "other"
  },
  "q29_k1_charges_collected_by_the_department_o": {
   "text": "K1 charges collected by the Department of Revenue are paid into the general fund.",
   "p": 0.97,
   "class": "revenue_use"
  },
  "q30_general_fund_money_spent_on_k5_enforceme": {
   "text": "General-fund money spent on K5 enforcement staff is not available for other state programmes.",
