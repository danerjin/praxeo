 "unclear": [
  {
   "id": "U1",
   "text": "Whether seasonal workers count toward the 50 FTE threshold",
   "readings": [
    "U1-a: seasonal workers count by their hours, so about 380 seasonal firms with 30-49 year-round FTE are bound",
    "U1-b: seasonal workers are left out of the count, so those firms stay below the line"
   ],
   "components": {
    "U1-a": [
     "K1s"
    ],
    "U1-b": []
   }
  }
