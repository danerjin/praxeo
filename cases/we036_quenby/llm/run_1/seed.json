 "assumptions": {
  "A-1": {
   "text": "About 135,000 full-timers at firms of 50+ FTE are offered nothing, and about 105,000 are offered less than K1 requires, so K1 binds for them.",
   "p": 0.9,
   "class": "binding"
  },
  "A-2": {
   "text": "Some bound firms that offer nothing now choose to offer.",
   "p": 0.75,
   "class": "other"
  },
  "A-3": {
   "text": "Money wages are fixed in the short run by pay scales and yearly raises.",
   "p": 0.75,
   "class": "other"
  },
  "A-4": {
   "text": "Some bound firms choose to pay the charge for at least some full-timers.",
   "p": 0.9,
   "class": "other"
  },
  "A-5": {
   "text": "Some firms with plans short of K1 upgrade them rather than pay.",
   "p": 0.7,
   "class": "other"
  },
  "A-6": {
   "text": "Wages above the minimum can adjust over the medium horizon, as raises are set.",
   "p": 0.8,
   "class": "other"
  },
  "A-7": {
   "text": "At players, for the marginal pair, cover at 30% is worth less to the worker than its cost to the employer.",
   "p": 0.6,
   "class": "other"
  },
  "A-8": {
   "text": "Workers at payers have some alternative to bound full-time work, so the wage does not fall by the whole charge.",
   "p": 0.85,
   "class": "mobility"
  },
  "A-9": {
   "text": "The minimum wage binds for some workers at bound firms.",
   "p": 0.85,
   "class": "binding"
  },
  "A-10": {
   "text": "Some employers can reschedule jobs from 30 to 35 hours to under 30 at a cost below the per-head cost.",
   "p": 0.75,
   "class": "other"
  },
  "A-14": {
   "text": "Some firms near 50 FTE value staying below the line more than the extra work.",
   "p": 0.7,
   "class": "other"
  },
  "A-15": {
   "text": "Owners of firms near 50 know from January 2027 that the 2027 average decides 2028 status.",
   "p": 0.75,
   "class": "expectations"
  },
  "A-18": {
   "text": "Revenue cannot cheaply verify reported offers, and some firms report offers not made.",
   "p": 0.55,
   "class": "enforcement"
  },
  "A-21": {
   "text": "Business values reflect expected earnings, and buyers expected the Act from its introduction.",
   "p": 0.7,
   "class": "expectations"
  },
  "A-23": {
   "text": "Over the medium to long run, workers' alternatives to bound employment are clearly worse than employers' alternatives.",
   "p": 0.6,
   "class": "mobility"
  },
  "A-29": {
   "text": "The $4.1 million is new general-fund money.",
   "p": 0.9,
   "class": "revenue_use"
  },
  "A-33": {
   "text": "Some of the 380 seasonal firms do not offer qualifying cover to their full-timers.",
   "p": 0.75,
   "class": "binding"
  }
 }
}