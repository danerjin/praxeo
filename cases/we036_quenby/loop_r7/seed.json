 "assumptions": {
  "a1": {"text": "About 135,000 full-timers at firms of 50+ FTE are offered nothing, and about 105,000 are offered less than K1 requires, so K1 binds for them.", "class": "binding", "p": 0.9},
  "a2": {"text": "Some bound firms that offer nothing now choose to offer (mainly those with higher-paid staff who value cover, given the tax exclusion).", "class": "other", "p": 0.75},
  "a3": {"text": "Money wages are fixed in the short run by pay scales and yearly raises in at-will employment (CR-6, 0.8: stickiness as a premise).", "class": "other", "p": 0.75},
  "a4": {"text": "Some bound firms choose to pay the charge for at least some full-timers (all the capped firms, many mid-size low-wage firms).", "class": "other", "p": 0.9},
  "a5": {"text": "Some firms with plans short of K1 upgrade them rather than pay.", "class": "other", "p": 0.7},
  "a6": {"text": "Wages above the minimum can adjust over the medium horizon, as raises are set.", "class": "other", "p": 0.8},
  "a7": {"text": "At players, for the marginal pair, cover at 30% is worth less to the worker than its cost to the employer: they could have agreed on it, with the tax exclusion, and did not.", "class": "other", "p": 0.6},
  "a9": {"text": "The minimum wage binds for some workers at bound firms.", "class": "binding", "p": 0.85},
  "a10": {"text": "Some employers can reschedule jobs from 30 to 35 hours to under 30 at a cost below the per-head cost.", "class": "other", "p": 0.75},
  "a12": {"text": "The 45 capped firms stay above 100 uncovered full-timers.", "class": "other", "p": 0.9},
  "a14": {"text": "Some firms near 50 FTE value staying below the line more than the extra work.", "class": "other", "p": 0.7},
  "a15": {"text": "Owners of firms near 50 know from January 2027 that the 2027 average decides 2028 status.", "class": "expectations", "p": 0.75},
  "a29": {"text": "The $4.1 million is new general-fund money.", "class": "revenue_use", "p": 0.9},
  "a33": {"text": "Some of the 380 seasonal firms do not offer qualifying cover to their full-timers.", "class": "binding", "p": 0.75}
 }
