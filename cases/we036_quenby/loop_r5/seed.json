 "unclear": [
  {
   "id": "U1",
   "text": "Seasonal workers in the count toward the 50 FTE line.",
   "readings": [
    "U1-a: seasonal workers count by their hours, like any other employee",
    "U1-b: seasonal workers are left out of the count"
   ],
   "components": {
    "U1-a": [
     "k1_offer_seasonal",
