 "assumptions": {
  "a1": {
   "text": "Some blocks are bid at or above the reserve: bidders expect a license to be worth more than M40 million after the build-out cost.",
   "class": "binding",
   "p": 0.95
  },
  "a3": {
   "text": "The obligation is enforced: revocation is credible, so licensees build to 90% by the end of 2032.",
   "class": "enforcement",
   "p": 0.75
  },
  "a5": {
   "text": "Some bidders or holders use stakes or joint ventures below the affiliate line.",
   "class": "other",
   "p": 0.55
  },
  "a8": {
   "text": "Licensees would not, on their own, cover 90% of the population with the band by 2032 (about 65% commercially).",
   "class": "binding",
   "p": 0.8
  },
  "a9": {
   "text": "Some licensees overstate coverage, meet it by minimal sites, or miss the deadline.",
   "class": "enforcement",
   "p": 0.55
  },
  "a11": {
   "text": "Under U1-b, sales of licensee companies or long capacity leases are not treated as transfers.",
   "class": "enforcement",
   "p": 0.55
  },
  "a28": {
   "text": "Investors expected the award partly from the March 2026 consultation and fully from 1 March 2027.",
   "class": "expectations",
   "p": 0.8
  },
  "j1": {
   "text": "Households and businesses outside the cities and large towns value mobile coverage in the band.",
   "class": "other",
   "p": 0.8
  },
  "j2": {
   "text": "Some bidders would take more than two blocks if the cap allowed it.",
   "class": "binding",
   "p": 0.9
  },
  "j3": {
   "text": "Under U1-b, the Authority enforces the bar on transfers before the coverage deadline.",
