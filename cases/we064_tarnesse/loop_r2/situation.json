 "assumptions": {
  "a1": {
   "text": "Some blocks are bid at or above the reserve: bidders expect a license to be worth more than M40 million after the build-out cost.",
   "p": 0.95,
   "class": "binding"
  },
  "a3": {
   "text": "The obligation is enforced: revocation is credible, so licensees build to 90% by the end of 2032.",
   "p": 0.75,
   "class": "enforcement"
  },
  "a8": {
   "text": "Licensees would not, on their own, cover 90% of the population with the band by 2032 (about 65% commercially).",
   "p": 0.8,
   "class": "binding"
  },
  "a17": {
   "text": "Some operators win blocks at prices below their own value for them (the cap holds the clearing price at the third-highest bidder's value).",
   "p": 0.6,
   "class": "other"
  },
  "a28": {
   "text": "Investors expected the award partly from the March 2026 consultation and fully from 1 March 2027.",
   "p": 0.8,
   "class": "expectations"
  },
  "a30": {
   "text": "A license is revoked and the band re-auctioned.",
   "p": 0.3,
   "class": "other"
  },
  "j1": {
   "text": "The reserve price of M40 million a block binds: some blocks would sell for less without it.",
   "p": 0.15,
   "class": "binding"
  },
  "j2": {
   "text": "Households outside the cities and large towns value mobile coverage from the band.",
   "p": 0.7,
   "class": "other"
  },
  "q9_some_licensees_overstate_coverage_meet_i": {
   "text": "Some licensees overstate coverage, meet it by minimal sites, or miss the deadline.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q10_without_the_band_operators_would_densify": {
   "text": "Without the band, operators would densify sites in the existing bands; with it, they densify less.",
   "p": 0.75,
   "class": "substitutability"
  },
  "q11_licensees_entrants_and_town_councils_can": {
   "text": "Licensees, entrants and town councils can organize to lobby at a cost below their stakes.",
   "p": 0.85,
   "class": "other"
  },
  "q12_the_band_is_used_to_add_capacity_where_b": {
   "text": "The band is used to add capacity where busy-hour demand presses on existing capacity.",
   "p": 0.85,
   "class": "other"
  },
  "q13_licensees_compete_on_price_no_network_le": {
   "text": "Licensees compete on price; no network leaves the market because of the award in the medium run.",
   "p": 0.7,
   "class": "other"
  },
  "q14_licensees_borrow_part_of_what_they_pay_a": {
   "text": "Licensees borrow part of what they pay and build in Tarnesse's loan market.",
   "p": 0.7,
   "class": "other"
  },
  "q15_some_bidders_or_holders_use_stakes_or_jo": {
   "text": "Some bidders or holders use stakes or joint ventures below the affiliate line.",
   "p": 0.55,
   "class": "other"
  },
  "q16_some_licensees_pool_blocks_by_network_sh": {
   "text": "Some licensees pool blocks by network-sharing agreements.",
   "p": 0.6,
   "class": "other"
  },
  "q17_at_least_one_of_linmark_and_ombra_wins_b": {
   "text": "At least one of Linmark and Ombra wins blocks and builds a network.",
   "p": 0.6,
   "class": "other"
  },
  "q18_some_investors_without_networks_bid_only": {
   "text": "Some investors without networks bid only if they can resell before the deadline.",
   "p": 0.55,
   "class": "other"
  },
  "q19_under_u1_b_sales_of_licensee_companies_o": {
   "text": "Under U1-b, sales of licensee companies or long capacity leases are not treated as transfers.",
   "p": 0.55,
   "class": "enforcement"
  },
  "q20_after_the_auction_some_licensees_value_t": {
   "text": "After the auction, some licensees value their licenses less than others would (an entrant cannot finance the build-out, or values change).",
   "p": 0.6,
   "class": "other"
  },
  "q21_the_treasury_borrows_less_than_it_would_": {
   "text": "The Treasury borrows less than it would have, by part of the receipts.",
   "p": 0.6,
   "class": "revenue_use"
  },
  "q22_sites_cannot_be_added_at_an_unchanged_co": {
   "text": "Sites cannot be added at an unchanged cost per site in the period, and cost per site does not fall as building expands (permits 4 to 9 months; riggers scarce).",
   "p": 0.8,
   "class": "durability"
  },
  "q23_riggers_cannot_be_added_at_once_certific": {
   "text": "Riggers cannot be added at once (certification takes 6 to 12 months).",
   "p": 0.75,
   "class": "durability"
  },
  "q24_equipment_vendors_supply_cannot_expand_a": {
   "text": "Equipment vendors' supply cannot expand at an unchanged cost in the period.",
   "p": 0.6,
   "class": "durability"
  },
  "q25_the_site_capacity_taken_by_the_band_buil": {
   "text": "The site capacity taken by the band build-out (co-location on existing sites in the cities, about 2,000 new towers and their tenancies outside them) exceeds the site capacity that the densification not done would have taken.",
   "p": 0.65,
   "class": "other"
  },
  "q26_fixed_wireless_in_the_band_substitutes_f": {
   "text": "Fixed wireless in the band substitutes for DSL for some households outside fibre areas.",
   "p": 0.7,
   "class": "substitutability"
  },
  "q27_the_six_blocks_are_all_that_is_offered_w": {
   "text": "The six blocks are all that is offered, whatever the price.",
   "p": 0.95,
   "class": "other"
  },
  "q28_pellow_s_copper_network_cannot_be_withdr": {
   "text": "Pellow's copper network cannot be withdrawn or its costs cut at once.",
   "p": 0.8,
   "class": "durability"
  },
  "q29_some_new_riggers_are_trained_or_move_fro": {
   "text": "Some new riggers are trained or move from other work in the medium run.",
   "p": 0.8,
   "class": "mobility"
  }
 }
}