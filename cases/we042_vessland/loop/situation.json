 "assumptions": {
  "a1": {
   "text": "Imports remain a material share of supply, so the domestic price is set at import parity.",
   "class": "binding",
   "p": 0.9
  },
  "a2": {
   "text": "Most covered imports pay the tariff; misdeclaration is limited.",
   "class": "enforcement",
   "p": 0.85
  },
  "a14": {
   "text": "Foreign smelters have far better alternatives than Vessland's users.",
   "class": "substitutability",
   "p": 0.9
  },
  "a17": {
   "text": "Customs' appropriation does not rise with the new work.",
   "class": "revenue_use",
   "p": 0.8
  },
  "a18": {
   "text": "Vessland's purchases are large enough to lower the world price.",
   "class": "other",
   "p": 0.15
  },
  "a21": {
   "text": "Users expect the tariff and can import and store metal ahead of 1 September at a cost below $500 a tonne.",
   "class": "expectations",
   "p": 0.8
  },
  "a22": {
   "text": "Some home users keep buying covered aluminum at the higher price.",
   "class": "other",
   "p": 0.95
  },
  "a26": {
   "text": "Exporters with qualifying content file claims; for most, the paperwork costs less than the refund.",
   "class": "other",
   "p": 0.9
  },
  "a28": {
   "text": "Some claimants' actual metal use per tonne of exported product is below Customs' yield tables, so they claim by the tables, as K2 allows at their option.",
   "class": "other",
   "p": 0.6
  },
  "q10_the_smelters_can_bring_their_idle_70_000": {
   "text": "The smelters can bring their idle 70,000 t into use within months.",
   "p": 0.75,
   "class": "other"
  },
